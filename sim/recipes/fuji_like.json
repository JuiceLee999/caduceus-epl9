  "conventions": {
    "range": "-7..7 for sat/hue/light/tone (stock firmware: sat -5..5, hue and light must be 0); contrast -5..5; vignette -5..5",
    "wb_shift": "a_b positive = amber, negative = blue; g_m positive = magenta, negative = green; -7..7 (E-P7 WB fine-tune steps)",
    "hue": "positive = rotate toward the PREVIOUS sector in sector_order (index-1, wrapping yellow->yellow_green), i.e. counter-clockwise in CIELAB a*b* and BT.601 CbCr; e.g. red+ -> orange, blue+ -> violet, green+ -> green_cyan. Chosen to match sim/pipeline.py, which adds the hue slider to atan2(Cr,Cb) while firmware sector centre angles decrease with ui_index.",
    "vignette": "negative = darker corners (Olympus shading-effect convention; verify on camera)",
    "grain": "off|low|medium|high = E-P7 film grain levels; colour recipes with grain need the planned colour-grain mod",
    "baseline": "all values are relative to an E-P7 Color Profile at 0, assumed to approximate PROVIA",
    "status": "untested starting points derived from public LUT measurements and descriptions; validate against Fuji JPEGs / ColorChecker shots"
  },
