/* E-P7 1.1 v0.25: per-profile lens shading compensation off (ep7-firmware, our own code). docs/VIDEO_HIDDEN.md 5.
 *
 * sc_get takes the place of the property getter at the four reads of Shading Comp. (key 0x8c21, sid 61). Same contract
 * as patches/wb/wb_get: the site's `call <rel32>,[d2,d3],12` frame, d0 key, d1 idx, a0 arg -> d0 value. Slot byte +49 == 1
 * on the current COLOR1-4 profile returns 0 (stock Off) after a real getter call, so every register but d0 is stock.
 * Otherwise the getter runs on the site's frame with the original d1 and a0 (the 0x6029fe64 site passes a0 = a3).
 *
 * sg / ss / su: Extras sector 8 (index 7). They take the place of three jumps in the v0.19 tone_x layer, reached with
 * d3 = 7 only from that sector's new paths; any other sector goes on to the original target. +49 is (81,a2) with a2 = P + 64k.
 * nr_get does the same at the stills Noise Filter reads (capture, MakerNote) from the look's NR byte, read at every shot, so
 * it follows a profile switch and leaves the camera's own setting alone.
 * Stores: the slot byte through a2 as tone_x does. No absolute stores, no mul/div/setlb.
 */
 .am33_2
 .text
 .global _start
_start:
sc_get:
 mov d1,d2                        /* idx, a0: the frame saved the site's d2/d3 */
 mov a0,d3
 call sc_slot,[],4
 cmp 0,a0
 beq sc_pass
 movbu (49,a0),d0
 cmp 1,d0
 bne sc_pass
 mov 35873,d0
 mov d2,d1
 mov d3,a0
 clr d2                           /* stock Off */
sc_real:                          /* d0/d1/a0 = the read, d2 = the value to return */
 call ep7_getter,[d2,d3],12
 mov d2,d0
 ret [d2,d3],12
sc_pass:
 mov 35873,d0
sc_tail:
 mov d2,d1
 mov d3,a0
 jmp ep7_getter

nr_get:                           /* stills Noise Filter (key 0x9719), byte +24: 0 camera, 1 Low, 2..5 Off, 6 Standard */
 mov d1,d2
 mov a0,d3
 call sc_slot,[],4
 cmp 0,a0
 beq nr_pass
 movbu (24,a0),d0
 add -1,d0
 cmp 6,d0
 bcc nr_pass                      /* 0 and 7+ (unsigned): the camera's own value */
 mov nr_map,a1
 movbu (d0,a1),d0
 extb d0
 mov d2,d1
 mov d3,a0
 mov d0,d2
 mov 38681,d0
 bra sc_real
nr_pass:
 mov 38681,d0
 bra sc_tail
nr_map:
 .byte 0xff,0xfe,0xfe,0xfe,0xfe,0

/* Film pick tail (lt_post's jump, a2 = P, d3 = k; was ng_pick): a library look sets the slot's Shading byte: 1 off, unless the record's
 * mask has bit 2 (the look keeps the camera's correction). Own and Stock keep what u_apply copied (snapshot / 0). */
 .set FL_MAGIC, {lmagic}
 .set FF_MAGIC, {fmagic}
sl_pick:
 mov (1020,a2),d0
 cmp FF_MAGIC,d0
 bne 9f
 mov (1016,a2),a0
 mov a0,d0
 btst 3,d0
 bne 9f
 add {npool},d0
 cmp {llim},d0
 bcc 9f
 mov (2112,a0),d0
 cmp FL_MAGIC,d0
 bne 9f
 mov (2116,a0),d0
 mov a2,d1
 cmp d1,d0
 bne 9f
 cmp 4,d3
 bcc 9f
 mov a0,a1
 add d3,a1
 movbu (2121,a1),d0
 cmp 0,d0
 beq 9f
 movbu (2120,a0),d1
 inc d1
 cmp d1,d0
 bcc 9f
 asl 6,d0
 add d0,a0
 movbu (46,a0),d1
 mov d3,d0
 asl 6,d0
 add a2,d0
 mov d0,a1
 clr d0
 btst 4,d1
 bne 8f
 mov 1,d0
8:
 movbu d0,(81,a1)
9:
 jmp ep7_fm_post

/* -> a0 = table entry of the current COLOR1-4 profile, or 0. Keeps d2/d3. */
sc_slot:
 mov 38017,d0                     /* picture mode; 6 is re-resolved as wb_get does */
 call sc_prop,[],4
 cmp 6,d0
 bne 1f
 mov 40209,d0
 call sc_prop,[],4
1:
 cmp 11,d0
 bne 2f
 mov 63153,d0                     /* COLOR profile */
 call sc_prop,[],4
 add -1,d0
 cmp 4,d0
 bcc 2f
 call ep7_tbl_idx,[d2,d3],8       /* d0 = slot -> a0 = entry (loaded table or flashed) */
 ret [],4
2:
 mov 0,a0
 ret [],4
sc_prop:
 clr d1
 mov 0,a0
 call ep7_getter,[d2,d3],12
 ret [],4

sg:                               /* ex_get, sector >= 7 or an out-of-range Blacks/Whites: a1 = out */
 cmp 7,d3
 bne 1f
 movbu (81,a2),d0
 cmp 1,d0
 bne 1f
 jmp ep7_g_val
1:
 jmp ep7_g_zero

ss:                               /* ex_set, sector >= 7: d1 = wheel value */
 cmp 7,d3
 bne 2f
 cmp 1,d1
 blt 1f
 mov 1,d1
 bra 3f
1:
 clr d1
3:
 movbu d1,(81,a2)
 jmp ep7_s_dirty
2:
 jmp ep7_s_refresh

su:                               /* ex_guide: d3 = sector, a2 = text; sector 7 names its own value */
 cmp 7,d3
 bne 2f
 mov (8,sp),d0
 add d3,d0
 mov sp,a1
 add 4,a1
 calls ep7_ex_get
 cmp 0,d0
 bne 3f
 mov (4,sp),d1
 mov su_cam,a2
 cmp 1,d1
 bne 2f
 mov su_off,a2
2:
 jmp ep7_q_put0
3:
 jmp ep7_q_out
su_cam:
 .asciz "8 VigFix Camera"
su_off:
 .asciz "8 VigFix Off"
sc_end:
