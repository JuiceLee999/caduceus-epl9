/* E-P7 1.1 "profile bundle" patch v0.2 (our own code; ep7-firmware).
 *
 * Placed in the section-1 FF tail (section 1 loads before section 2, which
 * holds every hook site). Three entry points:
 *
 *   conv1   jmp from 0x603e66ab (converter 0x603e62d1, all picture modes)
 *   conv2   jmp from 0x603e91f0 (converter 0x603e8af1, all picture modes)
 *           Both copy capture+24083 (profile number) and capture+24053
 *           (picture mode) into the job extension and set a marker:
 *             job+15488 profile, job+15489 mode, job+15490 = MAGIC
 *           (params = job+36, so job+X = params+(X-36)).
 *           The job allocation is extended 15488 -> 15512 and the tail memset
 *           16 -> 40 bytes, so the extension is 0 for every job that never
 *           passes through conv1/conv2 (live view, compact, other builders).
 *   hl      jmp from 0x603b02d9 (COLOR selector, call to builder 0x603b0068).
 *           Re-issues the builder call, proves the request is embedded in a
 *           job (callback / record / parent guard), checks marker, mode == 11
 *           and profile 1..4, checks the slot's enable flag and that all 24
 *           UI values are in -7..7, and only then overwrites hue/L of the 12
 *           output records. Any failed check leaves the stock output untouched.
 */
 .am33_2
 .text
 .global _start
_start:

/* Bundle table FIRST, so its address is fixed at the placement base
 * (BUNDLE_TABLE in patches/bundles/build.py and layout.json; other patches read it). */
 .balign 4
bundle_table:  /* 8 slots x 64 B: COLOR1-4 = 0-3, MONO1-4 = 4-7 */
{table}
bundle_table_end:
 .balign 4
hue_lut:     /* native hue for UI -7..7 = -1000 * ui */
{hue_lut}
light_lut:   /* native lightness for UI -7..7 */
{light_lut}
perm:        /* physical record r -> UI index */
{perm}
code_start:

/* ---------------------------------------------------------------- conv1
 * At 0x603e66ab: a3 = capture+24053 (picture mode), d3 = params (job+36),
 * (20,sp) = capture record. Displaced: movbu (a3),d0; cmp 12,d0;
 * bne 0x603e66d5 (fall through 0x603e66b1). a0 == d3 there in stock and is
 * reloaded by both successors; d0 and flags are recomputed below. */
conv1:
 mov (20,sp),a0
 movbu ({cap_profile},a0),d0
 mov d3,a0
 movbu d0,({ext_profile_p},a0)
 movbu (a3),d0
 movbu d0,({ext_mode_p},a0)
 mov {magic},d0
 movbu d0,({ext_magic_p},a0)
 movbu (a3),d0                 /* displaced instructions, a0 == d3 as stock */
 cmp 12,d0
 bne 1f
 jmp ep7_conv1_mono
1:
 jmp ep7_conv1_next

/* ---------------------------------------------------------------- conv2
 * At 0x603e91f0: (20,sp) = params, (24,sp) = capture, (36,sp) = capture+24053.
 * Displaced: mov (36,sp),a0; movbu (a0),d0; cmp 12,d0. Resume at the bne. */
conv2:
 mov (24,sp),a0
 movbu ({cap_profile},a0),d0
 mov (20,sp),a0
 movbu d0,({ext_profile_p},a0)
 mov (36,sp),a0
 movbu (a0),d0
 mov (20,sp),a0
 movbu d0,({ext_mode_p},a0)
 mov {magic},d0
 movbu d0,({ext_magic_p},a0)
 mov (36,sp),a0                /* displaced instructions */
 movbu (a0),d0
 cmp 12,d0
 jmp ep7_conv2_resume

/* ---------------------------------------------------------------- hl */
hl:
 call ep7_builder,[d2,d3,a2,a3],96   /* displaced stock instruction */
 add -28,sp                          /* inline frame: no second CALL */
 mov d0,(0,sp)
 mov d1,(4,sp)
 mov d2,(8,sp)
 mov d3,(12,sp)
 mov a0,(16,sp)
 mov a1,(20,sp)
 mov a3,(24,sp)
 mov (4,a2),a1                       /* context+4 -> request */
 mov (a1),d0
 cmp {callback},d0
 bne out
 mov (4,a1),d0                       /* request+4 -> selected record */
 mov a1,a0
 add {rec_off},a0
 mov {n_rec},d2
scan:
 cmp a0,d0
 beq hit
 add {stride},a0
 add -1,d2
 bne scan
 bra out
hit:
 mov (a0),d1                         /* record+0 = parent job */
 mov a1,a0
 add -{req_in_job},a0                /* a0 = job */
 cmp a0,d1
 bne out
 movbu ({ext_magic},a0),d0
 cmp {magic},d0
 bne out
 movbu ({ext_mode},a0),d0
 cmp 11,d0                           /* COLOR only in v0.2 */
 bne out
 movbu ({ext_profile},a0),d0         /* COLOR profile number 1..4 */
 add -1,d0
 cmp 4,d0
 bcc out                             /* unsigned: 0 and 5..255 rejected */
{tbl_hl}
 movbu (31,a0),d0                    /* flags: bit1 = H/L enabled */
 btst 2,d0
 beq out
 clr d2                              /* validate hue[12], light[12] */
val:
 movbu (d2,a0),d0
 extb d0
 add 7,d0
 cmp 15,d0
 bcc out                             /* outside -7..7 -> stock */
 inc d2
 cmp 24,d2
 bne val
 mov (12,a2),a3                      /* context+12 -> colour output */
 add {hue_off},a3                    /* record 0 hue */
 clr d2                              /* physical record r */
rec:
 mov perm,a1
 movbu (d2,a1),d1                    /* UI index w = 2*(r%6)+r/6 */
 movbu (d1,a0),d0                    /* hue_ui[w] */
 extb d0
 add 7,d0
 add d0,d0
 mov hue_lut,a1
 movhu (d0,a1),d3
 movhu d3,(a3)
 add 12,d1
 movbu (d1,a0),d0                    /* light_ui[w] */
 extb d0
 add 7,d0
 add d0,d0
 mov light_lut,a1
 movhu (d0,a1),d3
 movhu d3,(4,a3)                     /* L at hue+4 */
 add 24,a3
 inc d2
 cmp 12,d2
 bne rec
out:
 mov (0,sp),d0
 mov (4,sp),d1
 mov (8,sp),d2
 mov (12,sp),d3
 mov (16,sp),a0
 mov (20,sp),a1
 mov (24,sp),a3
 add 28,sp
 jmp ep7_resume

code_end:
