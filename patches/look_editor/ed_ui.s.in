/* E-P7 1.1 look editor, phase 1 UI + save (ep7-firmware, our own code). docs/LOOK_EDITOR.md.
 * Section 6.
 *
 * 12d: the Delete/Movie cycle (ed_event, record words +36/+52) is gone; the cycle key is INFO (ed_info in
 * ed_view, record word +44). The records' +36/+52 words are stock again.
 *   ed_init  <- COLOR1-4 parent records +4 (0x61185be0/c18/c50/c88; stock 0x60e20a54), called once when the
 *               editor parent is built (0x60e20864, CALLS, a0 parent, d0 key): axis back to S; with the key probe
 *               built in, the probe slots P+{probe_r}/P+{probe_o} are cleared (P valid, marker or not).
 *   ed_poke  <- jmp from ed_info (ed_view) after an axis step (frame: [d2,d3,a2,a3] + 12, a3 = parent).
 *               Re-writes the editor's cursor setting (1091/1096/1097/1686) with its current value through the
 *               facade (GetValue +8, SetValue +0), as the INFO handler does, so the settings listeners rebuild
 *               the screen. Returns 1 (handled).
 *   PROBE 1 only (key probe, shown by ed_guide):
 *   ed_rprobe <- editor parent vtable +68 word 0x61187578 (stock 0x60e20cdc, the router, every editor parent).
 *   ed_oprobe <- editor parent vtable +0 word 0x61187534 (stock 0x60dd5250, the object's event entry, which
 *               calls the router only when (0x61fc1bac) is 0). Both store the event code (u16) at
 *               P+{probe_r} / P+{probe_o} when P is valid and 0x9000 <= code < 0x9100, code is not 0x9014/0x9015
 *               (INFO, the redraw key) and code != stored + 1 (the release right after its press); then jmp to
 *               the stock routine with every register intact.
 *   ed_trig  <- loader v3 sd_back `jmp 0x602c8064` (0x605b7420): runs after the loader on every TRIG event in
 *               HLS_EVENT (the camera-proven file context). On a half-press with dirty set: one save attempt.
 *
 * Heap state (block P of the SD look loader, P+{emark}..): 'EP7E', axis (0 S, 1 L, 2 H), dirty, status.
 */
 .am33_2
 .text
 .global _start
_start:
 .set PROBE, {probe}

/* P validation: out a2 = P; uses d3, a2. */
 .macro PVAL miss
 movhu ({state}),d3
 add -1,d3
 cmp {lim},d3
 bcc \miss
 btst 3,d3
 bne \miss
 mov d3,a2
 add {pool},a2
 mov (a2),d3
 cmp {bmagic},d3
 bne \miss
 .endm

ed_init:                          /* CALLS entry: a0 parent, d0 key */
 movm [d3,a2],(sp)
 PVAL i_out
 .if PROBE
 clr d3
 mov d3,({probe_r},a2)            /* key probe: router + outer slots (u16 each) */
 .endif
 mov ({emark},a2),d3
 cmp {emagic},d3
 bne i_out
 clr d3
 movbu d3,({axis},a2)             /* a new editor always starts on the stock axis (S) */
i_out:
 movm (sp),[d3,a2]
 jmp ep7_init

ed_poke:                          /* from ed_info: a3 = parent (key checked there), axis stepped */
 movhu (100,a3),d0
 mov 1091,d2                      /* the editor's cursor setting */
 cmp 0x13b3,d0
 beq 1f
 mov 1096,d2
 cmp 0x13b4,d0
 beq 1f
 mov 1097,d2
 cmp 0x13b5,d0
 beq 1f
 mov 1686,d2
1:
 call ep7_facade,[],4             /* a0 = OlyApiSettingControllerController */
 mov (a0),a2
 mov (8,a2),a2                    /* GetValue(id, &out) */
 mov sp,a1
 add 4,a1
 mov d2,d0
 calls (a2)
 cmp 0,d0
 bne 2f                           /* no value: no write */
 call ep7_facade,[],4
 mov (a0),a2
 mov (a2),a2                      /* SetValue(id, 0, the same value) */
 mov d2,d0
 clr d1
 mov (4,sp),a1
 calls (a2)
2:
 mov 1,d0
 ret [d2,d3,a2,a3],28

 .if PROBE
/* key probe: d0 = event; keeps every register (flags aside) */
 .macro KLOG off
 cmp 0x9000,d0
 bcs 93f
 cmp 0x9100,d0
 bcc 93f
 cmp 0x9014,d0
 beq 93f
 cmp 0x9015,d0
 beq 93f
 PVAL 93f
 movhu (\off,a2),d3
 inc d3
 cmp d3,d0
 beq 93f
 movhu d0,(\off,a2)
93:
 .endm
ed_rprobe:                        /* editor vtable +68 (router) */
 movm [d3,a2],(sp)
 KLOG {probe_r}
 movm (sp),[d3,a2]
 jmp ep7_router
ed_oprobe:                        /* editor vtable +0 (event entry) */
 movm [d3,a2],(sp)
 KLOG {probe_o}
 movm (sp),[d3,a2]
 jmp ep7_entry
 .endif


/* ---------------------------------------------------------------- save (HLS_EVENT; ed_trig is in ed_core) */
/* a2 = P (validated). -> d0 status: 1 saved, 2 no memory, 3 .NEW failed, 4 .BIN failed (.NEW is good).
 * S = malloc(2048): image S+0 (n = 544 or 680), old .BIN S+{old}, read-back S+{rbd}. */
ed_save:
 mov 2048,d0
 call ep7_malloc,[],4
 mov a0,a3
 mov 2,d0
 cmp 0,a3
 beq v_ret
 clr d2                           /* copy P[0..679] -> S */
1:
 mov a2,a0
 add d2,a0
 movbu (a0),d0
 mov a3,a0
 add d2,a0
 movbu d0,(a0)
 inc d2
 cmp 680,d2
 bne 1b
 mov 544,d2                       /* d2 = n */
 mov (672,a2),d0
 cmp {nmagic},d0
 bne 2f
 mov a3,a0                        /* names valid: CRC-32 of S[544..675] at S+676, n = 680 */
 add 544,a0
 mov 132,d0
 mov -1,d1
 call ed_crc,[d2,d3],8
 not d1
 mov d1,(676,a3)
 mov 680,d2
2:
 mov a3,a0                        /* header CRC-32 of S[0..15] + S[20..543] at S+16 */
 mov 16,d0
 mov -1,d1
 call ed_crc,[d2,d3],8
 mov a3,a0
 add 20,a0
 mov 524,d0
 call ed_crc,[d2,d3],8
 not d1
 mov d1,(16,a3)
 mov ed_p_new,a0                  /* 1. BUNDLES.NEW, verified by read-back */
 mov a3,a1
 mov d2,d0
 call ed_wfile,[d2,d3,a2,a3],28
 mov d0,d3
 mov 3,d0
 cmp 0,d3
 bne v_free
 mov ed_p_bin,a0                  /* 2. old BUNDLES.BIN -> BUNDLES.BAK (only a 544/680-byte file) */
 mov ed_m_r,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq 4f
 mov a0,a2                        /* a2 = handle (P no longer needed) */
 mov a3,a0
 add {old},a0
 mov 1,d0
 mov 680,d1
 mov a2,a1
 call ep7_fread,[d2,d3,a2,a3],24
 mov d0,d3
 mov a2,a0
 call ep7_fclose,[d2,a2,a3],16
 cmp 544,d3
 beq 3f
 cmp 680,d3
 bne 4f
3:
 mov ed_p_bak,a0
 mov a3,a1
 add {old},a1
 mov d3,d0
 call ed_wfile,[d2,d3,a2,a3],28   /* a .BAK failure does not stop the save */
4:
 mov ed_p_bin,a0                  /* 3. BUNDLES.BIN, verified by read-back */
 mov a3,a1
 mov d2,d0
 call ed_wfile,[d2,d3,a2,a3],28
 mov d0,d3
 mov 4,d0
 cmp 0,d3
 bne v_free
 mov 1,d0
v_free:
 mov d0,d2
 mov a3,a0
 call ep7_free,[],4
 mov d2,d0
v_ret:
 ret [d2,d3,a2,a3],24

/* a0 path, a1 buf, d0 n (<= 680), a3 = S (the caller's) -> d0 0 ok / 1 fail.
 * Read-back always into S+{rbd}..S+2047 (680 B), never relative to buf. Locals: (4,sp) buf, (8,sp) handle. */
ed_wfile:
 mov a0,a2
 mov d0,d2
 mov a1,(4,sp)
 mov ed_m_w,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq w_fail
 mov a0,(8,sp)
 mov a0,a1                        /* fwrite(buf, 1, n, h) */
 mov d2,d1
 mov 1,d0
 mov (4,sp),a0
 call ep7_fwrite,[d2,d3,a2,a3],24
 mov d0,d3
 mov (8,sp),a0
 call ep7_fclose,[d2,a2,a3],16
 cmp d2,d3
 bne w_fail
 mov a2,a0                        /* read back */
 mov ed_m_r,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq w_fail
 mov a0,(8,sp)
 mov a0,a1
 mov a3,a0
 add {rbd},a0
 mov 1,d0
 mov 680,d1
 call ep7_fread,[d2,d3,a2,a3],24
 mov d0,d3
 mov (8,sp),a0
 call ep7_fclose,[d2,a2,a3],16
 cmp d2,d3
 bne w_fail
 mov (4,sp),a0
 mov a3,a1
 add {rbd},a1
5:
 movbu (a0),d0
 movbu (a1),d1
 cmp d0,d1
 bne w_fail
 inc a0
 inc a1
 add -1,d2
 bne 5b
 clr d0
 ret [d2,d3,a2,a3],28
w_fail:
 mov 1,d0
 ret [d2,d3,a2,a3],28

/* CRC-32 (zlib polynomial, reflected), no table: a0 ptr, d0 len > 0, d1 running crc -> d1. */
ed_crc:
 movbu (a0),d2
 xor d2,d1
 mov 8,d3
1:
 mov d1,d2
 and 1,d2
 lsr 1,d1
 cmp 0,d2
 beq 2f
 xor 0xedb88320,d1
2:
 add -1,d3
 bne 1b
 inc a0
 add -1,d0
 bne ed_crc
 ret [d2,d3],8

ed_p_new:
 .asciz "C:\\EP7MOD\\BUNDLES.NEW"
ed_p_bak:
 .asciz "C:\\EP7MOD\\BUNDLES.BAK"
ed_p_bin:
 .asciz "C:\\EP7MOD\\BUNDLES.BIN"
ed_m_w:
 .asciz "w"
ed_m_r:
 .asciz "r"
ed_ui_end:
