/* E-P7 1.1 look editor, phase 1 UI + save (ep7-firmware, our own code). docs/LOOK_EDITOR.md.
 * Section 6 (same section as the editor code it is reached from).
 *
 *   ed_event <- COLOR1-4 parent records +36 (0x61185c00/c38/c70/ca8; stock 0x60e22191), copied to parent+72
 *               and called by the parent router 0x60e20cdc (vtable+68) for every event it does not route
 *               elsewhere, incl. 0x9016 (Delete). CALLS entry: d0 event, d1 arg, a0 parent.
 *           and <- COLOR1-4 parent records +52 (0x61185c10/c48/c80/cb8; stock 0, so the parent keeps the .data
 *               default 0x60e228fb `clr d0; retf`), copied to parent+88: the router sends 0x9012 (Movie) there.
 *               Same CALLS convention. Delete never reaches the editor on camera; Movie is the working trigger.
 *   ed_init  <- COLOR1-4 parent records +4 (0x61185be0/c18/c50/c88; stock 0x60e20a54), called once when the
 *               editor parent is built (0x60e20864, CALLS, a0 parent, d0 key): axis back to S.
 *   ed_trig  <- loader v3 sd_back `jmp 0x602c8064` (0x605b7420): runs after the loader on every TRIG event in
 *               HLS_EVENT (the camera-proven file context). On a half-press with dirty set: one save attempt.
 *
 * Heap state (block P of the SD look loader, P+{emark}..): 'EP7E', axis (0 S, 1 L, 2 H), dirty, status.
 * Delete (0x9016) or Movie (0x9012) on a COLOR1-4 editor with a valid loaded table: axis S -> L -> H -> S, then
 * the stock child refresh 0x60de3670 on the 12 sector children (re-reads through the facade, i.e. ed_get),
 * return 1 (handled, the router restarts the parent's refresh timer like Up/Down do). Any guard failure: stock
 * with registers intact: 0x9012 -> the +52 default 0x60e228fb (returns 0), anything else -> 0x60e22191.
 */
 .am33_2
 .text
 .global _start
_start:

/* P validation: out a2 = P; uses d3, a2. */
 .macro PVAL miss
 movhu ({state}),d3
 add -1,d3
 cmp {lim},d3
 bcc \miss
 btst 3,d3
 bne \miss
 mov d3,a2
 add {pool},a2
 mov (a2),d3
 cmp {bmagic},d3
 bne \miss
 .endm

ed_event:
 cmp 0x9016,d0
 beq 1f
 cmp 0x9012,d0
 beq 1f
 jmp ep7_event                    /* every other event: stock, untouched */
1:
 movm [d2,d3,a2,a3],(sp)
 add -12,sp
 mov d0,(0,sp)
 mov d1,(4,sp)
 mov a1,(8,sp)
 mov a0,a3
 cmp 0,a3
 beq e_no
 movhu (100,a3),d0                /* editor key -> first sector setting id in d2 */
 mov 927,d2
 cmp 0x13b3,d0
 beq 2f
 mov 939,d2
 cmp 0x13b4,d0
 beq 2f
 mov 951,d2
 cmp 0x13b5,d0
 beq 2f
 mov 1655,d2
 cmp 0x140c,d0
 bne e_no
2:
 movhu (120,a3),d0
 cmp 13,d0
 bne e_no
 mov (16,a3),d0                   /* no held-key / timer gesture in progress */
 cmp 0,d0
 bne e_no
 mov (44,a3),d0
 cmp 0,d0
 bne e_no
 PVAL e_no
 mov a3,a0                        /* children 1..12: present, ids d2..d2+11 in order */
 mov 12,d1
 mov d2,d0
3:
 mov (128,a0),a1
 cmp 0,a1
 beq e_no
 movhu (84,a1),d3
 cmp d0,d3
 bne e_no
 inc d0
 add 4,a0
 add -1,d1
 bne 3b
 mov ({emark},a2),d0              /* axis: S -> L -> H -> S */
 cmp {emagic},d0
 beq 4f
 clr d0
 movbu d0,({axis},a2)
 movbu d0,({dirty},a2)
 movbu d0,({status},a2)
 mov {emagic},d0
 mov d0,({emark},a2)
4:
 movbu ({axis},a2),d0
 inc d0
 cmp 3,d0
 bcs 5f
 clr d0
5:
 movbu d0,({axis},a2)
 mov 128,d2                       /* refresh children 1..12 from the facade (stock routine) */
6:
 mov a3,a0
 add d2,a0
 mov (a0),a0
 call ep7_refresh,[d2,d3,a2,a3],60
 add 4,d2
 cmp 176,d2
 bne 6b
 mov 1,d0
 ret [d2,d3,a2,a3],28
e_no:
 mov a3,a0
 mov (4,sp),d1
 mov (8,sp),a1
 mov (0,sp),d0
 add 12,sp
 movm (sp),[d2,d3,a2,a3]
 btst 4,d0                        /* d0 is 0x9016 (bit 2 set) or 0x9012 here */
 bne 7f
 jmp ep7_movie                    /* Movie: the stock +52 default (clr d0; retf) */
7:
 jmp ep7_event

ed_init:                          /* CALLS entry: a0 parent, d0 key */
 movm [d3,a2],(sp)
 PVAL i_out
 mov ({emark},a2),d3
 cmp {emagic},d3
 bne i_out
 clr d3
 movbu d3,({axis},a2)             /* a new editor always starts on the stock axis (S) */
i_out:
 movm (sp),[d3,a2]
 jmp ep7_init

/* ---------------------------------------------------------------- save (HLS_EVENT; ed_trig is in ed_core) */
/* a2 = P (validated). -> d0 status: 1 saved, 2 no memory, 3 .NEW failed, 4 .BIN failed (.NEW is good).
 * S = malloc(2048): image S+0 (n = 544 or 680), old .BIN S+{old}, read-back S+{rbd}. */
ed_save:
 mov 2048,d0
 call ep7_malloc,[],4
 mov a0,a3
 mov 2,d0
 cmp 0,a3
 beq v_ret
 clr d2                           /* copy P[0..679] -> S */
1:
 mov a2,a0
 add d2,a0
 movbu (a0),d0
 mov a3,a0
 add d2,a0
 movbu d0,(a0)
 inc d2
 cmp 680,d2
 bne 1b
 mov 544,d2                       /* d2 = n */
 mov (672,a2),d0
 cmp {nmagic},d0
 bne 2f
 mov a3,a0                        /* names valid: CRC-32 of S[544..675] at S+676, n = 680 */
 add 544,a0
 mov 132,d0
 mov -1,d1
 call ed_crc,[d2,d3],8
 not d1
 mov d1,(676,a3)
 mov 680,d2
2:
 mov a3,a0                        /* header CRC-32 of S[0..15] + S[20..543] at S+16 */
 mov 16,d0
 mov -1,d1
 call ed_crc,[d2,d3],8
 mov a3,a0
 add 20,a0
 mov 524,d0
 call ed_crc,[d2,d3],8
 not d1
 mov d1,(16,a3)
 mov ed_p_new,a0                  /* 1. BUNDLES.NEW, verified by read-back */
 mov a3,a1
 mov d2,d0
 call ed_wfile,[d2,d3,a2,a3],28
 mov d0,d3
 mov 3,d0
 cmp 0,d3
 bne v_free
 mov ed_p_bin,a0                  /* 2. old BUNDLES.BIN -> BUNDLES.BAK (only a 544/680-byte file) */
 mov ed_m_r,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq 4f
 mov a0,a2                        /* a2 = handle (P no longer needed) */
 mov a3,a0
 add {old},a0
 mov 1,d0
 mov 680,d1
 mov a2,a1
 call ep7_fread,[d2,d3,a2,a3],24
 mov d0,d3
 mov a2,a0
 call ep7_fclose,[d2,a2,a3],16
 cmp 544,d3
 beq 3f
 cmp 680,d3
 bne 4f
3:
 mov ed_p_bak,a0
 mov a3,a1
 add {old},a1
 mov d3,d0
 call ed_wfile,[d2,d3,a2,a3],28   /* a .BAK failure does not stop the save */
4:
 mov ed_p_bin,a0                  /* 3. BUNDLES.BIN, verified by read-back */
 mov a3,a1
 mov d2,d0
 call ed_wfile,[d2,d3,a2,a3],28
 mov d0,d3
 mov 4,d0
 cmp 0,d3
 bne v_free
 mov 1,d0
v_free:
 mov d0,d2
 mov a3,a0
 call ep7_free,[],4
 mov d2,d0
v_ret:
 ret [d2,d3,a2,a3],24

/* a0 path, a1 buf, d0 n (<= 680), a3 = S (the caller's) -> d0 0 ok / 1 fail.
 * Read-back always into S+{rbd}..S+2047 (680 B), never relative to buf. Locals: (4,sp) buf, (8,sp) handle. */
ed_wfile:
 mov a0,a2
 mov d0,d2
 mov a1,(4,sp)
 mov ed_m_w,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq w_fail
 mov a0,(8,sp)
 mov a0,a1                        /* fwrite(buf, 1, n, h) */
 mov d2,d1
 mov 1,d0
 mov (4,sp),a0
 call ep7_fwrite,[d2,d3,a2,a3],24
 mov d0,d3
 mov (8,sp),a0
 call ep7_fclose,[d2,a2,a3],16
 cmp d2,d3
 bne w_fail
 mov a2,a0                        /* read back */
 mov ed_m_r,a1
 call ep7_fopen,[],4
 cmp 0,a0
 beq w_fail
 mov a0,(8,sp)
 mov a0,a1
 mov a3,a0
 add {rbd},a0
 mov 1,d0
 mov 680,d1
 call ep7_fread,[d2,d3,a2,a3],24
 mov d0,d3
 mov (8,sp),a0
 call ep7_fclose,[d2,a2,a3],16
 cmp d2,d3
 bne w_fail
 mov (4,sp),a0
 mov a3,a1
 add {rbd},a1
5:
 movbu (a0),d0
 movbu (a1),d1
 cmp d0,d1
 bne w_fail
 inc a0
 inc a1
 add -1,d2
 bne 5b
 clr d0
 ret [d2,d3,a2,a3],28
w_fail:
 mov 1,d0
 ret [d2,d3,a2,a3],28

/* CRC-32 (zlib polynomial, reflected), no table: a0 ptr, d0 len > 0, d1 running crc -> d1. */
ed_crc:
 movbu (a0),d2
 xor d2,d1
 mov 8,d3
1:
 mov d1,d2
 and 1,d2
 lsr 1,d1
 cmp 0,d2
 beq 2f
 xor 0xedb88320,d1
2:
 add -1,d3
 bne 1b
 inc a0
 add -1,d0
 bne ed_crc
 ret [d2,d3],8

ed_p_new:
 .asciz "C:\\EP7MOD\\BUNDLES.NEW"
ed_p_bak:
 .asciz "C:\\EP7MOD\\BUNDLES.BAK"
ed_p_bin:
 .asciz "C:\\EP7MOD\\BUNDLES.BIN"
ed_m_w:
 .asciz "w"
ed_m_r:
 .asciz "r"
ed_ui_end:
