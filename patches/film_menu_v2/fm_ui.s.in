/* E-P7 1.1 film-sims page "Film" in the Color Profile editor (ep7-firmware, our own code). docs/FILM_MENU_V2.md.
 * fm_ui: section 1, dead EVF gamma step-4 R/G/B tables 0x601e2c3c.. (only refs: step-table words 0x601e3cc0/c4/c8).
 * fm_core: section 9, 0x6143a410.. (FF; sec 9 is loaded whenever the loader's handle is valid: its gate needs all 9).
 *
 *   fm_valid <- the editor's ed_cfg_fv word (12e ed_page, on Light -> next page). CALLS, a2 = P (validated).
 *               -> d0 1 when LOOKS.BIN is loaded: P+1020 'EP7F', L = P+1016 inside the class-1 pool and 4-aligned,
 *               L+1408 'EP7L', L+1412 == P. Clobbers d0, d1, a0.
 *   fm_load  <- the editor's ed_cfg_fl word (12e ed_trig, every half-press with a valid P). CALLS, a2 = P.
 *               Once per power-on (P+1020 'EP7F' or 'EP7X' -> nothing): mark 'EP7X', malloc(2048) = L,
 *               fopen C:\EP7MOD\LOOKS.BIN "r", size = 64 + 64 n (1 <= n <= 20), fread, fclose, fm_check (the rules of
 *               tools/ep7_looks_bin.py check_file), the slot positions (a slot whose name matches a colour look
 *               resumes on it), publish L+1408 'EP7L', L+1412 P, P+1016 L, then P+1020 'EP7F' last. Any failure: free
 *               L, P+1020 stays 'EP7X'.
 *   fm_mod   <- the editor's ed_cfg_fm word (13; in fm_core): 1 when the slot entry differs from its picked look.
 *   fm_up / fm_down <- COLOR1-4 records +12 / +16 (0x61185be8/bec, c20/c24, c58/c5c, c90/c94; stock Up 0x60e20e0a /
 *               Down 0x60e2107a), copied to parent+48/+52: every value step (dial, arrows, touch) of the editor.
 *               CALLS: d0 event, d1 arg, a0 parent. Only on the Film page (axis P+{axis} == 3, 'EP7E', fm_valid,
 *               editor key 0x13b3/0x13b4/0x13b5/0x140c -> slot k): step this slot's position over
 *               [own, colour looks 1..n, Stock] (wrapping, mono looks skipped), write the slot entry (flags byte
 *               cleared first, set last) and name P+544+16k ('EP7N' after the name), set dirty P+{dirty} (the
 *               editor's half-press save writes BUNDLES.BIN), then the editor's ed_poke (cursor re-write: the guide
 *               shows the new name), return 1. Anything else: jmp to the stock handler with registers intact.
 * L layout: +0 LOOKS.BIN (<= 1344 B), +1408 'EP7L', +1412 P, +1416 n, +1417 pos[4], +1421 snap[4],
 *   +1428 own snapshots 4 x 80 B (entry 64 + name 16), +1752 staging 80 B (ends 1832 < 2048).
 * Stores: P, L (heap) and the stack only. No absolute stores, no mul/div, no setlb/Lcc.
 */
 .am33_2
 .text
 .global _start
_start:

 .set FL_MAGIC, {lmagic}
 .set FF_MAGIC, {fmagic}
 .set FX_MAGIC, {xmagic}

/* L handle check: a2 = P -> a0 = L on success, else branch to \miss. Uses d0, d1, a0. */
 .macro FVAL miss
 mov (1020,a2),d0
 cmp FF_MAGIC,d0
 bne \miss
 mov (1016,a2),a0
 mov a0,d0
 btst 3,d0
 bne \miss
 add {npool},d0
 cmp {llim},d0
 bcc \miss
 mov (1408,a0),d0
 cmp FL_MAGIC,d0
 bne \miss
 mov (1412,a0),d0
 mov a2,d1
 cmp d1,d0
 bne \miss
 .endm

/* P validation: out a2 = P; uses d3, a2. */
 .macro PVAL miss
 movhu ({state}),d3
 add -1,d3
 cmp {lim},d3
 bcc \miss
 btst 3,d3
 bne \miss
 mov d3,a2
 add {pool},a2
 mov (a2),d3
 cmp {bmagic},d3
 bne \miss
 .endm

fm_valid:                         /* CALLS, a2 = P -> d0 */
 FVAL 1f
 mov 1,d0
 rets
1:
 clr d0
 rets

fm_up:
 movm [d2,d3,a2,a3],(sp)
 add -12,sp
 mov 1,d2
 bra u_go
fm_down:
 movm [d2,d3,a2,a3],(sp)
 add -12,sp
 mov -1,d2
u_go:
 mov d0,(0,sp)
 mov d1,(4,sp)
 mov a1,(8,sp)
 mov a0,a3
 cmp 0,a3
 beq u_miss
 PVAL u_miss
 mov ({emark},a2),d0
 cmp {emagic},d0
 bne u_miss
 movbu ({axis},a2),d0
 cmp 3,d0
 bne u_miss
 FVAL u_miss                      /* a0 = L */
 movhu (100,a3),d0                /* editor key -> k (d3) */
 clr d3
 cmp 0x13b3,d0
 beq 1f
 inc d3
 cmp 0x13b4,d0
 beq 1f
 inc d3
 cmp 0x13b5,d0
 beq 1f
 inc d3
 cmp 0x140c,d0
 bne u_miss
1:
 mov d3,(4,sp)                    /* (4,sp) = k from here on (no fallback after the guards) */
 movbu (1416,a0),d1               /* n (1..20) */
 inc d1                           /* d1 = n + 1 = the Stock position */
 mov a0,a1
 add d3,a1
 movbu (1417,a1),d0               /* pos */
2:
 add d2,d0
 cmp 0,d0
 bge 3f
 mov d1,d0
3:
 cmp d1,d0
 bls 4f
 clr d0
4:
 cmp 0,d0
 beq 5f                           /* own */
 cmp d1,d0
 beq 5f                           /* Stock */
 mov d0,d3                        /* record pos-1 = L + 64 pos: COLOR mask bit 0, else keep stepping */
 asl 6,d3
 add a0,d3
 mov d3,a1
 movbu (46,a1),d3
 btst 1,d3
 beq 2b
5:
 mov (4,sp),d3                    /* d3 = k */
 mov d0,(8,sp)                    /* (8,sp) = pos */
 mov a0,a1
 add d3,a1
 movbu d0,(1417,a1)               /* the new position */
 movbu (1421,a1),d0               /* first step for this slot: snapshot entry + name ("own") */
 cmp 0,d0
 bne 6f
 mov 1,d0
 movbu d0,(1421,a1)
 call fm_snap,[d2],8              /* d0 = L + 1428 + 80k */
 mov d0,a1
 mov d3,d0                        /* entry P+32+64k */
 asl 6,d0
 add a2,d0
 add 32,d0
 mov 64,d1
 call fm_copy,[d2,a2],8
 mov 16,d1
 mov (672,a2),d0
 cmp {nmagic},d0
 bne 61f
 mov d3,d0                        /* name P+544+16k */
 asl 4,d0
 add a2,d0
 add 544,d0
 call fm_copy,[d2,a2],8
 bra 6f
61:
 call fm_zero,[d2],8              /* no names: an empty name */
6:
 mov (8,sp),d0                    /* staging T = L + 1752 (80 B): the new entry + name */
 mov a0,a1
 add 1752,a1
 cmp 0,d0
 bne 7f
 call fm_snap,[d2],8              /* own: T = snapshot */
 mov 80,d1
 call fm_copy,[d2,a2],8
 bra u_apply
7:
 movbu (1416,a0),d1
 inc d1
 cmp d1,d0
 bne 8f
 mov 80,d1                        /* Stock: all zero */
 call fm_zero,[d2],8
 bra u_apply
8:
 asl 6,d0                         /* look: record pos-1 at L + 64 pos */
 add a0,d0
 mov d0,(8,sp)
 mov 32,d1                        /* bytes 0..31 */
 call fm_copy,[d2,a2],8
 mov 32,d1                        /* +32..63 = 0 (colour slot: +32 = 0, sat advice 33..44 dropped, 45..63 = 0) */
 call fm_zero,[d2],8
 mov (8,sp),d0
 add 48,d0                        /* name r+48 */
 mov 16,d1
 call fm_copy,[d2,a2],8
u_apply:                          /* T -> slot k: flags byte first cleared, last written; then the name */
 mov a0,a1
 add 1752,a1                      /* a1 = T */
 mov d3,d0
 asl 6,d0
 add a2,d0
 add 32,d0
 mov d0,a0                        /* a0 = entry */
 clr d0
 movbu d0,(31,a0)
 clr d1
9:
 cmp 31,d1
 beq 10f
 movbu (d1,a1),d0
 movbu d0,(d1,a0)
10:
 inc d1
 cmp 64,d1
 bne 9b
 movbu (31,a1),d0
 movbu d0,(31,a0)
 mov (672,a2),d0                  /* names section: zero it first when the table had none */
 cmp {nmagic},d0
 beq 11f
 mov a2,a0
 add 544,a0
 clr d0
 mov 128,d1
12:
 movbu d0,(a0)
 inc a0
 add -1,d1
 bne 12b
11:
 mov d3,d0
 asl 4,d0
 add a2,d0
 add 544,d0
 mov d0,a0
 add 64,a1                        /* T+64 = name */
 clr d1
13:
 movbu (d1,a1),d0
 movbu d0,(d1,a0)
 inc d1
 cmp 16,d1
 bne 13b
 mov {nmagic},d0
 mov d0,(672,a2)
 mov 1,d0
 movbu d0,({dirty},a2)            /* the editor's save writes BUNDLES.BIN on the next half-press */
 jmp ed_poke                      /* cursor re-write (the guide shows the new name), return 1 */
u_miss:
 mov a3,a0
 mov (4,sp),d1
 mov (8,sp),a1
 mov (0,sp),d0
 add 12,sp
 cmp 0,d2
 movm (sp),[d2,d3,a2,a3]
 blt 1f
 jmp ep7_up
1:
 jmp ep7_down

/* fm_copy: d0 = src, a1 = dst, d1 = n > 0 -> a1 = dst + n. `call fm_copy,[d2,a2],8`. */
fm_copy:
 mov d0,a2
1:
 movbu (a2),d2
 movbu d2,(a1)
 inc a2
 inc a1
 add -1,d1
 bne 1b
 ret [d2,a2],8
/* fm_zero: a1 = dst, d1 = n > 0 -> a1 = dst + n. `call fm_zero,[d2],8`. */
fm_zero:
 clr d2
1:
 movbu d2,(a1)
 inc a1
 add -1,d1
 bne 1b
 ret [d2],8
/* fm_snap: a0 = L, d3 = k -> d0 = L + 1428 + 80 k. `call fm_snap,[d2],8`. */
fm_snap:
 mov d3,d0
 asl 4,d0
 mov d0,d2
 asl2 d0
 add d2,d0
 add a0,d0
 add 1428,d0
 ret [d2],8

 .balign 4
fm_ui_end:
