/* grain_cpu d1: t1 + a readout of the last capture and a dark band on COLOR4. docs/GRAIN_PORT.md. Our own code.
 * Diagnostic block: 64 B from malloc (uncached heap, 0xa...), pointer at heap P+1000, magic at +0. Written and read only
 * through that uncached address, so any CPU sees it. Lives until power off.
 *  +4 guard, +5 stage, +6 read flag, +7 next page, +8 counts F<<8 | G<<4 | R, +12 blend result, +14 rows done,
 *  +16 format, +18 stride, +20 Hw, +22 rows, +24 x | y, +28 bus, +32 size, +36 band<<4 | mode, +37 class, +40 CPU address, +44 seed
 * Stage keeps the highest value since the block was last cleared; the first capture after a read clears it. */
 .set HW_MAX, 5461
 .set GDIA, 0x41494447
 .set NPAGE, 14

gc_pp:                            /* leaf, MDR return: a0 = heap P or 0. Uses d0 */
 mov 0,a0
 movhu ({state}),d0
 add -1,d0
 cmp {lim},d0
 bcc 9f
 btst 3,d0
 bne 9f
 mov d0,a0
 add {pool},a0
 mov (a0),d0
 cmp {bmagic},d0
 beq 8f
 mov 0,a0
 retf [],0
9:
 mov 0,a0
8:
 retf [],0

gc_blk:                           /* `call gc_blk,[],8`: a1 = block or 0. Uses d0, a0 */
 mov 0,a1
 call gc_pp,[],0
 cmp 0,a0
 beq 9f
 mov (1000,a0),a0
 mov a0,d0
 cmp 0xa0000000,d0
 bcs 9f
 cmp 0xb0000000,d0
 bcc 9f
 btst 3,d0
 bne 9f
 mov (a0),d0
 cmp GDIA,d0
 bne 9f
 mov a0,a1
9:
 ret [],8

gc_clr:                           /* leaf: clear the block's +4..+43 and +48..+63 at a1. Uses d0, d1, a0 */
 mov a1,a0
 add 4,a0
 mov 15,d1
 clr d0
1:
 cmp 5,d1                         /* +44, the seed, stays */
 beq 2f
 mov d0,(a0)
2:
 add 4,a0
 add -1,d1
 bne 1b
 retf [],0

gc_mark:                          /* `call gc_mark,[d2,d3,a2,a3],32`, d0 = stage, d1 = guard. Uses d0, d1, a0, a1 */
 mov d0,d2
 mov d1,d3
 call gc_blk,[],8
 cmp 0,a1
 bne 2f
 call gc_pp,[],0
 cmp 0,a0
 beq 9f
 mov 64,d0
 call ep7_malloc,[],4
 cmp 0,a0
 beq 9f
 mov a0,a1
 call gc_clr,[],0
 clr d0
 mov d0,(44,a1)
 mov GDIA,d0
 mov d0,(a1)
 call gc_pp,[],0
 mov a1,(1000,a0)
2:
 movbu (5,a1),d0
 cmp d0,d2
 bcs 9f
 movbu d2,(5,a1)
 movbu d3,(4,a1)
9:
 ret [d2,d3,a2,a3],32

gc_cnt:                           /* `call gc_cnt,[d2],12`, d0 = what to add to the counts. Uses d0, a0, a1 */
 mov d0,d2
 call gc_blk,[],8
 cmp 0,a1
 beq 9f
 movhu (8,a1),d0
 add d2,d0
 movhu d0,(8,a1)
9:
 ret [d2],12

/* gc_flag: as t1, every exit has its own id. Stage 1. a2 = params+12, a3 = capture. */
gc_flag:
 clr d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32    /* makes the block on the first capture */
 call gc_blk,[],8
 cmp 0,a1
 beq 1f
 movbu (6,a1),d0
 cmp 0,d0
 beq 1f
 call gc_clr,[],0
1:
 mov 0x100,d0
 call gc_cnt,[d2],12
 movhu (-2,a2),d0
 mov 0x01,d1
 cmp 11,d0
 bne 9f
 movhu (-4,a2),d0
 mov 0x02,d1
 cmp 0,d0
 bne 9f
 movbu ({cap_mode},a3),d0
 mov 0x03,d1
 cmp 11,d0
 bne 9f
 movbu ({cap_profile},a3),d0
 mov 0x04,d1
 add -2,d0
 cmp 3,d0
 bcc 9f
 movhu (194,a3),d0
 mov 0x05,d1
 cmp 0x2001,d0
 beq 9f
 mov 0x06,d1
 cmp 0x2006,d0
 beq 9f
 mov 0x07,d1
 cmp 0x1008,d0
 beq 9f
 mov 0x08,d1
 cmp 0x1006,d0
 beq 9f
 mov (a2),d0
 or 128,d0
 mov d0,(a2)
 clr d1
9:
 mov 1,d0
 call gc_mark,[d2,d3,a2,a3],32
 jmp ep7_bloom_flag

/* gc_gs: the work-list word (`calls`, a0 = job). Stages 2 and 3. No block: stock, nothing to report with. */
gc_gs:
 movm [d2,d3,a2,a3],(sp)
 add -16,sp
 mov a0,(4,sp)
 mov 0x10,d0
 call gc_cnt,[d2],12
 mov (4,sp),a0
 movbu (15490,a0),d0
 mov 0x10,d1
 cmp 0xb2,d0
 bne 80f
 movbu (15489,a0),d0
 mov 0x11,d1
 cmp 11,d0
 bne 80f
 movhu (20,a0),d0
 mov 0x12,d1
 cmp 0x1000,d0
 bne 80f
 mov (11308,a0),d0
 mov 0x13,d1
 cmp 11,d0
 bne 80f
 movbu (15488,a0),d0
 mov 0x14,d1
 add -1,d0
 beq 80f
 cmp 4,d0
 bcc 80f
 mov d0,(8,sp)
 mov 2,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 call gc_blk,[],8
 cmp 0,a1
 beq 90f
 mov (4,sp),a0
 mov ep7_sf,a1
 calls (a1)
 mov d0,(12,sp)
 call gc_blk,[],8
 mov (12,sp),d0
 movhu d0,(12,a1)
 exthu d0
 mov 0x15,d1
 cmp 0,d0
 bne 70f
 mov (4,sp),a0
 mov 4096,d0
 call ep7_bufidx,[d2],4
 exthu d0
 mov 0x16,d1
 cmp 48,d0
 bcc 70f
 asl 3,d0
 mov d0,d1
 add d0,d0
 add d0,d1
 asl 2,d0
 add d0,d1
 mov (4,sp),a0
 add 6592,a0
 add d1,a0
 mov a0,(4,sp)
 mov 3,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 mov (4,sp),a0
 mov (8,sp),d0
 call gc_grain,[d2,d3,a2,a3],128
 bra 20f
70:
 mov 3,d0
 call gc_mark,[d2,d3,a2,a3],32
20:
 mov (12,sp),d0
 ret [d2,d3,a2,a3],32
80:
 mov 2,d0
 call gc_mark,[d2,d3,a2,a3],32
90:
 mov (4,sp),a0
 add 16,sp
 movm (sp),[d2,d3,a2,a3]
 jmp ep7_sf

{gc_open}
