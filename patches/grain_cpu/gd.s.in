 movhu (10,a0),d0
 movhu d0,(18,a1)
 movhu (12,a0),d0
 movhu d0,(20,a1)
 movhu (14,a0),d0
 movhu d0,(22,a1)
 movhu (16,a0),d0
 movhu (18,a0),d1
 or d1,d0
