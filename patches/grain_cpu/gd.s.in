 and 0xfc000000,d0
 mov 0x2d,d1
 cmp 0xc0000000,d0
 beq 60f
 and 0x07ffffff,d2
 add d3,d2
 mov 0x2e,d1
 cmp 0x08000001,d2
 bcc 60f
3:
 mov (44,sp),d0
 mov d0,d1
 lsr 1,d1
 mov d1,(28,sp)
 mov d1,(84,sp)
 lsr 1,d1
 mov d1,(32,sp)
 mov d1,(72,sp)
 mov d0,d1
 add d0,d0
 add d1,d0
 call ep7_malloc,[],4
 mov 0x2f,d1
 cmp 0,a0
 beq 60f
 mov a0,(36,sp)
 mov 8192,d0
 call ep7_malloc,[],4
 cmp 0,a0
