/* gc_fw: the Firmware view's Body value setter calls (`call gc_fw,[d2,d3,a2,a3],88`, a0 = widget, a1 = text). A non-empty value becomes
 * one page, "<letter><3 hex>"; each opening shows the next page. No block: "----". */
gc_fw:
 mov a0,a3
 cmp 0,a1
 beq 8f
 movhu (a1),d0
 cmp 0,d0
 beq 8f
 call gc_blk,[],8
 cmp 0,a1
 bne 1f
 mov gc_none,a1
 bra 8f
