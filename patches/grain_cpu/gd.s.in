{gc_shared}
gc_pg:                            /* page -> offset, size, shift */
 .byte 4,2,0, 8,2,0, 16,2,0, 20,2,2, 18,2,2, 22,2,2, 28,4,20, 28,4,8, 36,2,0, 40,4,20, 14,2,1, 24,2,0, 12,2,0, 32,4,20
