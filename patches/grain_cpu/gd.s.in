 mov d1,d3
 mov 0x26,d1
 cmp d0,d3
 bcs 60f
 add d3,d3
 mov d3,(24,sp)
 movhu (14,a0),d2
 mov d2,(48,sp)
 mov 0x27,d1
 cmp 0,d2
 beq 60f
 mov 0x28,d1
 cmp 8193,d2
 bcc 60f
 mov d3,d0
