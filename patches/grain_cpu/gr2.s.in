/* v0.27 film grain on COLOR stills (patches/grain_cpu r2: s3's grain, r1's release cleanup; ep7-firmware, our own code). docs/GRAIN_PORT.md. Model: verify_s1.py expected() (s3, camera-tested).
 * Method after androidfanman/caduceus-om3's CPU grain (Apache-2.0, repo 41e7e8b): a pass over the finished image's Y bytes through
 * this CPU's bus window, under the firmware's lock. Slot byte +50 = Grain (Extras sector 1), +24 = NR (sector 9).
 * Record, RAM only (no card writes): 128 B from malloc, pointer at heap P+1000, magic at +0; uncached accesses only.
 *  +4 guard, +5 stage, +8 counts, +10 active width, +12 blend result, +14 rows done, +16 format, +18 stride, +20 Hw, +22 rows,
 *  +24 x, +26 y, +28 bus, +32 size, +36 route<<4 | mode, +37 cpu<<4 | class, +38 level, +39 capture profile, +40 first CPU address,
 *  +44 seed, +48 job+16, +52 job+20, +54 job class, +55 job entries, +56 active height, +58 capture kind, +60 capture mode,
 *  +61 rows split, +64..+79 the first two buffers before the blend, +95 the level for the next work list.
 * Cleared at each flag-hook call (the previous job has run by then: the converter runs its job before returning). */
 .set HW_MAX, 5461
 .set GDIA, 0x41494447
 .set BLK, 128

gc_pp:                            /* leaf, MDR return: a0 = heap P or 0. Uses d0 */
 mov 0,a0
 movhu ({state}),d0
 add -1,d0
 cmp {lim},d0
 bcc 9f
 btst 3,d0
 bne 9f
 mov d0,a0
 add {pool},a0
 mov (a0),d0
 cmp {bmagic},d0
 beq 8f
 mov 0,a0
 retf [],0
9:
 mov 0,a0
8:
 retf [],0

gc_blk:                           /* `call gc_blk,[],8`: a1 = block or 0. Uses d0, a0 */
 mov 0,a1
 call gc_pp,[],0
 cmp 0,a0
 beq 9f
 mov (1000,a0),a0
 mov a0,d0
 cmp 0xa0000000,d0
 bcs 9f
 cmp 0xb0000000,d0
 bcc 9f
 btst 3,d0
 bne 9f
 mov (a0),d0
 cmp GDIA,d0
 bne 9f
 mov a0,a1
9:
 ret [],8

gc_clr:                           /* leaf: clear the live record's +4..+43 and +48..+79 at a1. Uses d0, d1, a0 */
 mov a1,a0
 add 4,a0
 mov 19,d1
 clr d0
1:
 cmp 9,d1                         /* +44, the seed, stays */
 beq 2f
 mov d0,(a0)
2:
 add 4,a0
 add -1,d1
 bne 1b
 retf [],0

gc_mark:                          /* `call gc_mark,[d2,d3,a2,a3],32`, d0 = stage, d1 = guard. Uses d0, d1, a0, a1 */
 mov d0,d2
 mov d1,d3
 call gc_blk,[],8
 cmp 0,a1
 bne 2f
 call gc_pp,[],0
 cmp 0,a0
 beq 9f
 mov BLK,d0
 call ep7_malloc,[],4
 cmp 0,a0
 beq 9f
 mov a0,a1
 mov BLK/4,d1
 clr d0
1:
 mov d0,(a0)
 add 4,a0
 add -1,d1
 bne 1b
 mov GDIA,d0
 mov d0,(a1)
 call gc_pp,[],0
 mov a1,(1000,a0)
2:
 movbu (5,a1),d0
 cmp d0,d2
 bcs 9f
 movbu d2,(5,a1)
 movbu d3,(4,a1)
9:
 ret [d2,d3,a2,a3],32

gc_cnt:                           /* `call gc_cnt,[d2],12`, d0 = what to add to the counts. Uses d0, a0, a1 */
 mov d0,d2
 call gc_blk,[],8
 cmp 0,a1
 beq 9f
 movhu (8,a1),d0
 add d2,d0
 movhu d0,(8,a1)
9:
 ret [d2],12

/* gc_flag: as t1, every exit has its own id. Stage 1. a2 = params+12, a3 = capture. */
gc_flag:
 clr d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32    /* makes the block on the first capture */
 clr d0
 call gc_pend,[d2,d3],12
 call gc_blk,[],8
 cmp 0,a1
 beq 2f
 call gc_clr,[],0
 movhu (194,a3),d0
 movhu d0,(58,a1)
 movbu ({cap_mode},a3),d0
 movbu d0,(60,a1)
 movbu ({cap_profile},a3),d0
 movbu d0,(39,a1)
2:
 mov 0x100,d0
 call gc_cnt,[d2],12
 movhu (-2,a2),d0
 mov 0x01,d1
 cmp 11,d0
 bne 9f
 movhu (-4,a2),d0
 mov 0x02,d1
 cmp 0,d0
 bne 9f
 movbu ({cap_mode},a3),d0
 mov 0x03,d1
 cmp 11,d0
 bne 9f
 movbu ({cap_profile},a3),d0
 mov 0x04,d1
 add -1,d0
 cmp 4,d0
 bcc 9f
 call ep7_tbl_idx,[d2,d3],8
 movbu (50,a0),d0                 /* Grain 1..3 */
 add -1,d0
 mov 0x04,d1
 cmp 3,d0
 bcc 9f
 movhu (194,a3),d0
 mov 0x05,d1
 cmp 0x2001,d0
 beq 9f
 mov 0x06,d1
 cmp 0x2006,d0
 beq 9f
 mov 0x07,d1
 cmp 0x1008,d0
 beq 9f
 mov 0x08,d1
 cmp 0x1006,d0
 beq 9f
 movbu (46,a0),d0                 /* an Art Effect keeps its passes, and the blend hook needs Soft Focus */
 add -1,d0
 cmp 2,d0
 bcs 1f
 movbu (50,a0),d0                 /* a plain look: the level for gc_wl, which runs before the converter writes the job's marker */
 call gc_pend,[d2,d3],12
 clr d1
 bra 9f
1:
 clr d1
 mov (a2),d0
 or 128,d0
 mov d0,(a2)
 clr d1
9:
 mov 1,d0
 call gc_mark,[d2,d3,a2,a3],32
 jmp ep7_bloom_flag

/* gc_gs: the work-list word (`calls`, a0 = job). Stages 2 and 3. No block: stock, nothing to report with. */
gc_gs:
 movm [d2,d3,a2,a3],(sp)
 add -16,sp
 mov a0,(4,sp)
 mov 0x10,d0
 call gc_cnt,[d2],12
 call gc_blk,[],8
 cmp 0,a1
 beq 1f
 mov (4,sp),a0
 mov (16,a0),d0
 mov d0,(48,a1)
 movhu (20,a0),d0
 movhu d0,(52,a1)
 movbu (11320,a0),d0
 movbu d0,(54,a1)
 movbu (11314,a0),d0
 movbu d0,(55,a1)
 add 6592,a0                      /* the first two buffer records in use, before the blend */
 mov a1,a2
 add 64,a2
 mov 48,d2
 mov 2,d3
3:
 mov (76,a0),d0
 cmp 0,d0
 beq 4f
 mov d0,(4,a2)
 mov (a0),d1
 mov d1,(a2)
 add 8,a2
 add -1,d3
 beq 1f
4:
 add 88,a0
 add -1,d2
 bne 3b
1:
 mov (4,sp),a0
 call gc_lvl,[d2,d3],16
 cmp 0,d0
 beq 80f
 mov d0,(8,sp)
 mov 2,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 call gc_blk,[],8
 cmp 0,a1
 beq 90f
 mov (4,sp),a0
 mov ep7_sf,a1
 calls (a1)
 mov d0,(12,sp)
 call gc_blk,[],8
 mov (12,sp),d0
 movhu d0,(12,a1)
 exthu d0
 mov 0x15,d1
 cmp 0,d0
 bne 70f
 mov (4,sp),a0
 mov 4096,d0
 call ep7_bufidx,[d2],4
 exthu d0
 mov 0x16,d1
 cmp 48,d0
 bcc 70f
 asl 3,d0
 mov d0,d1
 add d0,d0
 add d0,d1
 asl 2,d0
 add d0,d1
 mov (4,sp),a0
 add 6592,a0
 add d1,a0
 mov a0,(4,sp)
 mov 3,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 mov 0x10,d0                      /* route 1: after the blend */
 call gc_route,[],4
 mov (4,sp),a0
 mov (8,sp),d0
 call gc_grain,[d2,d3,a2,a3],144
 bra 20f
70:
 mov 3,d0
 call gc_mark,[d2,d3,a2,a3],32
20:
 mov (12,sp),d0
 ret [d2,d3,a2,a3],32
80:
 mov 2,d0
 call gc_mark,[d2,d3,a2,a3],32
90:
 mov (4,sp),a0
 add 16,sp
 movm (sp),[d2,d3,a2,a3]
 jmp ep7_sf

/* gc_lvl: `call gc_lvl,[d2,d3],16`, a0 = job -> d0 = level 1..3 or 0, then d1 = guard. Uses a0, a1 */
gc_lvl:
 movbu (15490,a0),d0
 mov 0x10,d1
 cmp 0xb2,d0
 bne 8f
 movbu (15489,a0),d0
 mov 0x11,d1
 cmp 11,d0
 bne 8f
 movhu (20,a0),d0
 mov 0x12,d1
 cmp 0x1000,d0
 bne 8f
 mov (11308,a0),d0
 mov 0x13,d1
 cmp 11,d0
 bne 8f
 movbu (15488,a0),d0
 mov 0x14,d1
 add -1,d0
 cmp 4,d0
 bcc 8f
 call ep7_tbl_idx,[d2,d3],8
 movbu (50,a0),d0
 mov 0x14,d1
 add -1,d0
 cmp 3,d0
 bcc 8f
 inc d0
 ret [d2,d3],16
8:
 clr d0
 ret [d2,d3],16

gc_route:                         /* `call gc_route,[],4`, d0 = route << 4: the record's +36 high nibble, +37 high nibble = this CPU */
 mov d0,d3
 call gc_blk,[],8
 cmp 0,a1
 beq 9f
 movbu (36,a1),d0
 and 15,d0
 or d3,d0
 movbu d0,(36,a1)
 mov (0x8050),d0
 asl 4,d0
 movbu d0,(37,a1)
9:
 ret [],4

/* gc_pend: `call gc_pend,[d2,d3],12`, d0 = level for the next work list (block +95). Uses d0, a0, a1 */
gc_pend:
 mov d0,d2
 call gc_blk,[],8
 cmp 0,a1
 beq 9f
 movbu d2,(95,a1)
9:
 ret [d2,d3],12

/* gc_wl: replaces the jmp wl_hook at the builder's hook 0x6035749f: d2 = key, a2 = job+4, a3 = list. It runs inside the constructor
 * (0x603537eb -> 0x60354709 -> 0x60356297), before the converter writes job+15488..15490, so the level comes from the flag hook of the
 * same capture (block +95), taken once. A plain COLOR still with it gets development + output pass, the shape of every COLOR grain
 * job up to v0.21. Stage 1 guards: 0x43 flags, 0x44 no shading bit, 0x4f route built. */
gc_wl:
 cmp 11,d2
 bne 8f
 movhu (16,a2),d0                 /* stills type: live view jobs don't touch the pending level */
 cmp 0x1000,d0
 bne 8f
 call gc_blk,[],8
 cmp 0,a1
 beq 8f
 movbu (95,a1),d0
 cmp 0,d0
 beq 8f
 add -1,d0
 cmp 3,d0
 bcc 8f
 clr d1
 movbu d1,(95,a1)                 /* taken */
 mov (12,a2),d1                   /* job+16 */
 mov d1,(48,a1)
 movhu (16,a2),d0
 movhu d0,(52,a1)
 mov d1,d0
 and 0x0007ffc0,d0                /* only the shading bit among 0x40..0x40000 */
 beq 1f
 mov 0x43,d1
 bra 7f
1:
 and 0x00080000,d1
 bne 2f
 mov 0x44,d1
 bra 7f
2:
 mov 0xa5,d0
 mov a2,a0
 add 15487,a0                     /* job+15491: gc_ob runs this job's grain */
 movbu d0,(a0)
 mov 1,d0
 mov 0x4f,d1
 call gc_mark,[d2,d3,a2,a3],32
 mov a3,a0
 mov 0x60356d7b,a1
 mov 0x60356cc6,d1
 mov 1,d0
 call ep7_wl_final,[d2,d3,a2,a3],16
 mov a3,a0
 mov gc_nomod,a1
 call ep7_wl_attach,[a2,a3],8
 jmp ep7_wl_after
7:
 mov 1,d0
 call gc_mark,[d2,d3,a2,a3],32
8:
 jmp ep7_wl_hook
gc_nomod:                         /* the modifier: holds the slot, so the Shading entry follows */
 clr d0
 retf [],0

/* gc_ob: the word for the output pass 0x6035b529 (`calls`, a0 = job). On a marked job: wait for the development request, then grain on 0x1000. */
gc_ob:
 movm [d2,d3,a2,a3],(sp)
 add -16,sp
 mov a0,(4,sp)
 movbu (15491,a0),d0
 cmp 0xa5,d0
 bne 90f
 mov 0x20,d0
 call gc_route,[],4
 mov 0x10,d0
 call gc_cnt,[d2],12
 mov (4,sp),a0
 call gc_lvl,[d2,d3],16
 mov d0,(8,sp)
 cmp 0,d0
 beq 80f
 mov 2,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 call gc_blk,[],8
 cmp 0,a1
 beq 90f
 mov (4,sp),a0
 call ep7_wait,[a2],8
 exthu d0
 mov d0,(12,sp)
 mov 0x17,d1
 cmp 0,d0
 bne 70f
 mov (4,sp),a0
 mov 4096,d0
 call ep7_bufidx,[d2],4
 exthu d0
 mov 0x16,d1
 cmp 48,d0
 bcc 70f
 asl 3,d0
 mov d0,d1
 add d0,d0
 add d0,d1
 asl 2,d0
 add d0,d1
 mov (4,sp),a0
 add 6592,a0
 add d1,a0
 mov 3,d2
 mov a0,a3
 mov d2,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 mov a3,a0
 mov (8,sp),d0
 call gc_grain,[d2,d3,a2,a3],144
 bra 90f
70:
 mov 3,d0
 call gc_mark,[d2,d3,a2,a3],32
 bra 90f
80:
 mov 2,d0
 call gc_mark,[d2,d3,a2,a3],32
90:
 mov (4,sp),a0
 add 16,sp
 movm (sp),[d2,d3,a2,a3]
 jmp ep7_ob

/* Extras. a2 = P + 64*slot, slot byte n at (32+n,a2). Sector 1 = Grain +50, sector 9 = NR +24 (u 0 camera, 1 Standard, 2 Low, 3 Off, the v0.22 mapping). */
gc_g1:                            /* ex_get sector 1 */
 movbu (82,a2),d0
 cmp 4,d0
 bcs 1f
 clr d0
1:
 jmp ep7_g_val
gc_s1:                            /* ex_set sector 1, d1 clamped 0..3 */
 movbu d1,(82,a2)
 jmp ep7_s_dirty
gc_sg9:                           /* ex_get, sector >= 7 */
 cmp 8,d3
 beq 1f
 jmp ep7_sg
1:
 movbu (56,a2),d0
 cmp 7,d0
 bcc 3f
 cmp 0,d0
 beq 2f
 cmp 6,d0
 bne 4f
 mov 1,d0
 bra 2f
4:
 cmp 1,d0
 bne 5f
 mov 2,d0
 bra 2f
5:
 mov 3,d0
 bra 2f
3:
 clr d0
2:
 jmp ep7_g_val
gc_ss9:                           /* ex_set, sector >= 7: d1 = wheel value */
 cmp 8,d3
 beq 1f
 jmp ep7_ss
1:
 cmp 1,d1
 blt 2f
 cmp 2,d1
 blt 3f
 beq 4f
 mov 2,d1                         /* 3 and up: Off */
 bra 5f
4:
 mov 1,d1
 bra 5f
3:
 mov 6,d1
 bra 5f
2:
 clr d1
5:
 movbu d1,(56,a2)
 jmp ep7_s_dirty
gc_su9:                           /* ex_guide: d3 = sector, a2 = text */
 cmp 8,d3
 beq 1f
 jmp ep7_su
1:
 mov (8,sp),d0
 add d3,d0
 mov sp,a1
 add 4,a1
 calls ep7_ex_get
 cmp 0,d0
 bne 3f
 mov (4,sp),d1
 cmp 4,d1
 bcc 3f
 asl2 d1
 mov gc_t9,a2
 add d1,a2
 mov (a2),a2
 jmp ep7_q_put0
3:
 jmp ep7_q_out
gc_def:                           /* ex_default after a hit (d2 = 64*slot + sector, a2 = P, a1 = out, frame of ex_default): sectors 1 and 9 answer
                                     their current value, so a reset to defaults leaves Grain and NR as the user set them; others 0 */
 mov d2,d3
 and 63,d3
 and 0xc0,d2
 add d2,a2
 clr d0
 cmp 0,d3
 bne 1f
 movbu (82,a2),d0
 cmp 4,d0
 bcs 9f
 clr d0
 bra 9f
1:
 cmp 8,d3
 bne 9f
 movbu (56,a2),d0
 cmp 7,d0
 bcc 3f
 cmp 0,d0
 beq 9f
 cmp 6,d0
 bne 4f
 mov 1,d0
 bra 9f
4:
 cmp 1,d0
 bne 5f
 mov 2,d0
 bra 9f
5:
 mov 3,d0
 bra 9f
3:
 clr d0
9:
 mov d0,(a1)
 movm (sp),[d2,d3,a2]
 rets

gc_ua:                            /* Film pick apply, a1 = T, d0 = slot entry: NR stays as the user set it */
 mov d0,a0
 movbu (24,a0),d0
 movbu d0,(24,a1)
 jmp ep7_ua_back
gc_um:                            /* the `*` compare: d2 = byte, a1 = entry, d0 = what a pick would write. NR doesn't count */
 movbu (d2,a1),d1
 cmp 24,d2
 beq 1f
 cmp d0,d1
 beq 1f
 jmp ep7_um_yes
1:
 jmp ep7_um_next

{gc_open}
/* gc_grain: as t1, with its own id on every exit. Stage 4 checks, 5 buffers, 6 rows, 7 done.
 * Locals: (0) slot, (4) rec, (8) S, (12) T, (16) row, (20) bus, (24) pitch, (32) span, (36) ring, (40) token, (44) Hw, (48) rows, (52) restore, (56) block, (60) level,
 * (64) previous offset, (68) ring pointer, (72) delta, (76) r, (80) row, (84) pixels, (88) T cached, (92) K, (96) rows this pass, (100) ring cached, (112) bus, (116) pixels left, (124) row in pass.
 * Record layout (0x60354aee): +8 format, +10 stride, +12 w, +14 h, +16 active w, +18 active h, +20 x, +22 y. */
gc_grain:
 mov a0,(4,sp)
 mov d0,(60,sp)
 mov 4,d1                         /* K: four rows per lock */
 mov d1,(92,sp)
 add -1,d0
 add d0,d0
 mov gc_stab,a1
 movhu (d0,a1),d0
 mov d0,(8,sp)
 mov 1,d0
 call gc_cnt,[d2],12
 call gc_blk,[],8
 mov a1,(56,sp)
 mov (60,sp),d0
 movbu d0,(38,a1)
 mov (4,sp),a0
 movhu (8,a0),d0
 movhu d0,(16,a1)
 movhu (10,a0),d0
 movhu d0,(18,a1)
 movhu (12,a0),d0
 movhu d0,(20,a1)
 movhu (14,a0),d0
 movhu d0,(22,a1)
 movhu (16,a0),d0
 movhu d0,(10,a1)
 movhu (18,a0),d0
 movhu d0,(56,a1)
 movhu (20,a0),d0
 movhu d0,(24,a1)
 movhu (22,a0),d0
 movhu d0,(26,a1)
 mov (a0),d0
 mov d0,(28,a1)
 mov (72,a0),d0
 mov d0,(32,a1)
 mov 4,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 mov (4,sp),a0
 movhu (8,a0),d0
 mov 0x20,d1
 cmp 0x0302,d0
 bne 60f
 movhu (20,a0),d0
 mov 0x21,d1
 cmp 0,d0
 bne 60f
 movhu (22,a0),d0
 mov 0x22,d1
 cmp 0,d0
 bne 60f
 movhu (12,a0),d0
 mov d0,(44,sp)
 mov 0x23,d1
 cmp 4,d0
 bcs 60f
 mov 0x24,d1
 cmp HW_MAX+1,d0
 bcc 60f
 mov 0x25,d1
 btst 3,d0
 bne 60f
 movhu (10,a0),d1
 mov d1,d3
 mov 0x26,d1
 cmp d0,d3
 bcs 60f
 add d3,d3
 mov d3,(24,sp)
 movhu (14,a0),d2
 mov d2,(48,sp)
 mov 0x27,d1
 cmp 0,d2
 beq 60f
 mov 0x28,d1
 cmp 8193,d2
 bcc 60f
 mov d3,d0
 mul d2,d0
 mov d0,d3                        /* the whole image, bytes */
 mov (72,a0),d2
 mov 0x29,d1
 cmp d2,d3
 bhi 60f
 mov (a0),d2
 mov d2,(20,sp)
 mov 0x2a,d1
 cmp 0xa0000000,d2
 bcs 60f
 cmp 0xb0000000,d2
 bcc 2f
 add d3,d2
 mov 0x2b,d1
 cmp 0xb0000001,d2
 bcc 60f
 bra 3f
2:
 mov 0x2c,d1
 cmp 0xe0000000,d2
 bcc 60f
 mov d2,d0
 add d3,d0                        /* the end: the whole buffer in the mapper's range */
 mov 0x32,d1
 cmp 0xe0000001,d0
 bcc 60f
 mov 0x2d,d1
 cmp 0xc4000000,d2                /* and clear of 0xc0000000..0xc3ffffff */
 bcc 3f
 cmp 0xc0000001,d0
 bcc 60f
3:
 mov 16383,d0                     /* offsets stay inside the ring */
 mov (44,sp),d1
 sub d1,d0
 mov d0,(32,sp)
 mov 16384,d0
 call ep7_malloc,[],4
 mov 0x2f,d1
 cmp 0,a0
 beq 60f
 mov a0,(36,sp)
 mov 8192,d0
 call ep7_malloc,[],4
 cmp 0,a0
 bne 1f
 mov (36,sp),a0
 call ep7_free,[],4
 mov 0x30,d1
 bra 60f
1:
 mov a0,(12,sp)
 mov 5,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 call ep7_flush,[d2,d3],16
 mov (12,sp),d0
 call gc_cach,[],0
 mov a0,(88,sp)
 mov (8,sp),d3
 mov gc_G,a1
 call gc_tbl,[d2,d3,a2,a3],16
 mov (36,sp),d0
 call gc_cach,[],0
 mov a0,(100,sp)
 mov (56,sp),a1
 mov (44,a1),d0
 cmp 0,d0
 bne 2f
 mov 0x12345678,d0
