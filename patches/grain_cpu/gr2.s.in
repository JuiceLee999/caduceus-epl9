 mov d0,(16,sp)
 mov 6,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
3:
 mov (48,sp),d0
 mov (16,sp),d1
 sub d1,d0
 mov (92,sp),d1
 cmp d1,d0
 bcc 1f
 mov d0,d1
1:
 mov d1,(96,sp)
 mov (16,sp),d0                   /* first byte of this pass */
 mov (24,sp),d1
 mul d1,d0
 mov (20,sp),d1
 add d1,d0
 mov d0,(112,sp)
 mov (96,sp),d1                   /* its last byte, same 128 MB slice? */
 add -1,d1
 mov (24,sp),d2
 mul d2,d1
 mov (44,sp),d2
 add d2,d2
 add d2,d1
 add -1,d1
 add d0,d1
 lsr 27,d0
 lsr 27,d1
 cmp d0,d1
 bne 30f
 mov (112,sp),d0
 mov d0,d3
 call gc_open,[d2,d3,a2,a3],32
 mov d0,(40,sp)
 mov d1,(52,sp)
 mov (56,sp),a1
 call gc_cls,[],8
 cmp 0,a0
 beq 6f
 mov a0,d0
 add -0x40000000,d0
 mov d0,(80,sp)
 mov (44,sp),d0
 mov d0,(84,sp)
 clr d0
 mov d0,(124,sp)
20:
 mov gc_next,a0
 calls (a0)
 mov gc_p2,a0
 calls (a0)
 mov (80,sp),d0
 mov (24,sp),d1
 add d1,d0
 mov d0,(80,sp)
 mov (124,sp),d0
 inc d0
 mov d0,(124,sp)
 mov (96,sp),d1
 cmp d1,d0
 bcs 20b
 bra 45f
30:                               /* the pass crosses a slice edge: one row at a time, each split where it must be */
 clr d0
 mov d0,(124,sp)
31:
 mov (124,sp),d0
 mov (16,sp),d1
 add d1,d0
 mov (24,sp),d1
 mul d1,d0
 mov (20,sp),d1
 add d1,d0
 mov d0,(112,sp)
 mov (44,sp),d0
 mov d0,(116,sp)
 mov gc_next,a0
 calls (a0)
32:
 mov (112,sp),d0
 mov d0,d3
 call gc_open,[d2,d3,a2,a3],32
 mov d0,(40,sp)
 mov d1,(52,sp)
 mov (56,sp),a1
 call gc_cls,[],8
 cmp 0,a0
 beq 6f
 mov a0,d0
 add -0x40000000,d0
 mov d0,(80,sp)
 mov (112,sp),d0                  /* pixels to this slice's end */
 and 0x07ffffff,d0
 mov 0x08000000,d1
 sub d0,d1
 lsr 1,d1
 mov (116,sp),d0
 cmp d0,d1
 bcc 1f
 mov d1,d0
 mov (56,sp),a1
 movbu (61,a1),d1
 inc d1
 movbu d1,(61,a1)
1:
 mov d0,(84,sp)
 mov gc_p2,a0
 calls (a0)
 mov (52,sp),d0
 cmp -1,d0
 bne 41f
 call ep7_flush,[d2,d3],16
 bra 42f
41:
 call ep7_modeset,[d2,d3,a2],20   /* flushes first */
42:
 mov (40,sp),d0
 call ep7_unlock,[d2],8
 mov (84,sp),d0
 mov (116,sp),d1
 sub d0,d1
 mov d1,(116,sp)
 cmp 0,d1
 beq 33f
 mov (68,sp),d1
 add d0,d1
 mov d1,(68,sp)
 add d0,d0
 mov (112,sp),d1
 add d0,d1
 mov d1,(112,sp)
 bra 32b
33:
 mov (124,sp),d0
 inc d0
 mov d0,(124,sp)
 mov (96,sp),d1
 cmp d1,d0
 bcs 31b
 bra 40f
45:
 mov (52,sp),d0
 cmp -1,d0
 bne 41f
 call ep7_flush,[d2,d3],16        /* the rows' lines written back before the lock goes */
 bra 42f
41:
 call ep7_modeset,[d2,d3,a2],20   /* flushes first */
42:
 mov (40,sp),d0
 call ep7_unlock,[d2],8
40:
 mov (16,sp),d0
 mov (96,sp),d1
 add d1,d0
 mov d0,(16,sp)
 mov (56,sp),a1
 movhu d0,(14,a1)
 mov (48,sp),d1
 cmp d1,d0
 bcs 3b
 mov 7,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 bra 7f
6:
 mov (40,sp),d0
 call ep7_unlock,[d2],8
 mov 6,d0
 mov 0x31,d1
 call gc_mark,[d2,d3,a2,a3],32
7:
 mov (56,sp),a1
 mov (76,sp),d0
 mov d0,(44,a1)
 call ep7_flush,[d2,d3],16
 mov (12,sp),a0
 call ep7_free,[],4
 mov (36,sp),a0
 call ep7_free,[],4
 bra 99f
60:
 mov 4,d0
 call gc_mark,[d2,d3,a2,a3],32
99:
 ret [d2,d3,a2,a3],144

/* gc_cls: `call gc_cls,[],8` under the lock: a0 = CPU address or 0, d1 = mode to restore or -1, d3 = bus, a1 = block. Records class, modes, first address.
 * Keeps a0. Uses d0. */
gc_cls:
 mov a0,(4,sp)
 mov 3,d0
 cmp 0,a0
 beq 2f
 mov 2,d0
 cmp -1,d1
 bne 1f
 mov 1,d0
 cmp 0xb0000000,d3
 bcc 2f
 clr d0
 bra 2f
1:
 movbu d1,(7,a1)
2:
 movbu (37,a1),d1
 and 0xf0,d1
 or d1,d0
 movbu d0,(37,a1)
 cmp 0,a0
 beq 3f
 mov (40,a1),d0
 cmp 0,d0
 bne 3f
 mov a0,(40,a1)
3:
 call ep7_modeget,[],0
 movbu (36,a1),d1
 and 0xf0,d1
 and 15,d0
 or d1,d0
 movbu d0,(36,a1)
 mov (4,sp),a0
 ret [],8

/* gc_fill: `calls`: ring (100,sp), r (76). 16384 B: n = low + high nibble of a random byte, ring[x] = (n[x] + n[x-1] + 1) >> 1, n[-1] = 15. */
gc_fill:
 mov (100,sp),a0
 mov 4096,a2
 mov (76,sp),a3
 mov 15,d3
1:
 mov a3,d0
 mov d0,d2
 asl 13,d2
 xor d2,d0
 mov d0,d2
 lsr 17,d2
 xor d2,d0
 mov d0,d2
 asl 5,d2
 xor d2,d0
 mov d0,a3
 mov 4,a1
2:
 mov d0,d1
 and 15,d1
 mov d0,d2
 lsr 4,d2
 and 15,d2
 add d2,d1
 mov d1,d2
 add d3,d2
 inc d2
 lsr 1,d2
 movbu d2,(a0)
 inc a0
 mov d1,d3
 lsr 8,d0
 add -1,a1
 cmp 0,a1
 bne 2b
 add -1,a2
 cmp 0,a2
 bne 1b
 mov a3,(76,sp)
 rets

/* gc_next: `calls`: one row's noise. r (76,sp) steps once; offset = ((r >> 8) & 0xffff) * span >> 16. Row noise = (ring[o + x] + ring[previous o + x] + 1) >> 1,
 * so neighbouring rows share half their noise (the vertical correlation of the model's filter). (68) = ring + o, (72) = previous o - o, (64) = o. */
gc_next:
 mov (76,sp),d0
 mov d0,d2
 asl 13,d2
 xor d2,d0
 mov d0,d2
 lsr 17,d2
 xor d2,d0
 mov d0,d2
 asl 5,d2
 xor d2,d0
 mov d0,(76,sp)
 lsr 8,d0
 and 0xffff,d0
 mov (32,sp),d1
 mul d1,d0
 lsr 16,d0
 mov (100,sp),d1
 add d0,d1
 mov d1,(68,sp)
 mov (64,sp),d1
 sub d0,d1
 mov d1,(72,sp)
 mov d0,(64,sp)
 rets

/* gc_p2: `calls`: row (80,sp), ring pointer (68), delta (72), pixels (84), T (88). */
gc_p2:
 mov (80,sp),a0
 mov (68,sp),a1
 mov (72,sp),d3
 mov (84,sp),a2
 mov (88,sp),a3
1:
 movbu (a1),d1
 movbu (d3,a1),d2
 add d2,d1
 inc d1
 lsr 1,d1
 movbu (a0),d2
 asl 5,d2
 or d1,d2
 movbu (d2,a3),d2
 movbu d2,(a0)
 add 2,a0
 inc a1
 add -1,a2
 cmp 0,a2
 bne 1b
 rets

{gc_cach}
{gc_tbl}
gc_btab:
 .byte 0xb0,0xb8,0xb0,0xb0,0xb0,0xb8
gc_mtab:
 .byte 0,0,2,3,4,4
 .balign 2
gc_stab:
 .hword 23,55,91

 .balign 4
gc_t9:
 .long gc_n0,gc_n1,gc_n2,gc_n3
gc_n0:
 .asciz "9 NR Camera"
gc_n1:
 .asciz "9 NR Std"
gc_n2:
 .asciz "9 NR Low"
gc_n3:
 .asciz "9 NR Off"
 .balign 4                        /* a word table: the camera faults on a misaligned read (s1 crashed here) */
gc_t1:
 .long gc_g0,gc_gl,gc_gm,gc_gh
gc_g0:
 .asciz "1 Grain Off"
gc_gl:
 .asciz "1 Grain Low"
gc_gm:
 .asciz "1 Grain Med"
gc_gh:
 .asciz "1 Grain High"
gc_G:
{g_bytes}
gc_end:
