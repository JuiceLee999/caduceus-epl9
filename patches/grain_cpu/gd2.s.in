/* grain_cpu d2: t1 + a record of each capture, saved on a half-press as C:\EP7MOD\GRAIND.BIN + a dark band on COLOR4. docs/GRAIN_PORT.md. Our own code.
 * Block: 736 B from malloc (uncached heap), pointer at heap P+1000, magic at +0. Only uncached accesses, no store into the image.
 *  Live record, 80 B: +0 magic, +4 guard, +5 stage, +6 committed, +8 counts F<<8 | G<<4 | R, +12 blend result, +14 rows done,
 *   +16 format, +18 stride, +20 Hw, +22 rows, +24 x | y, +28 bus, +32 size, +36 band<<4 | mode, +37 class, +38 level, +39 capture profile,
 *   +40 CPU address, +44 seed, +48 job+16, +52 job+20, +54 job class, +55 job entries, +56 job+11308 low, +58 capture kind, +60 capture mode, +62 capture number,
 *   +64 bus, +68 id of the first buffer record before the blend, +72, +76 the second.
 *  +80 file header, 16 B: 'GRND', u16 version, u16 captures, u16 80, u16 8, u16 writes, u8 unwritten change, pad. +96: 8 records, slot = capture number & 7.
 * The stage keeps the highest value since the record was cleared. A half-press copies it to its slot and writes the file if it changed;
 * the next capture copies once more, moves to the next slot and clears. File I/O only on the half-press path (HLS_EVENT), as MOVIE.BIN. */
 .set HW_MAX, 5461
 .set GDIA, 0x41494447
 .set BLK, 736
 .set FILE_N, 656

gc_pp:                            /* leaf, MDR return: a0 = heap P or 0. Uses d0 */
 mov 0,a0
 movhu ({state}),d0
 add -1,d0
 cmp {lim},d0
 bcc 9f
 btst 3,d0
 bne 9f
 mov d0,a0
 add {pool},a0
 mov (a0),d0
 cmp {bmagic},d0
 beq 8f
 mov 0,a0
 retf [],0
9:
 mov 0,a0
8:
 retf [],0

gc_blk:                           /* `call gc_blk,[],8`: a1 = block or 0. Uses d0, a0 */
 mov 0,a1
 call gc_pp,[],0
 cmp 0,a0
 beq 9f
 mov (1000,a0),a0
 mov a0,d0
 cmp 0xa0000000,d0
 bcs 9f
 cmp 0xb0000000,d0
 bcc 9f
 btst 3,d0
 bne 9f
 mov (a0),d0
 cmp GDIA,d0
 bne 9f
 mov a0,a1
9:
 ret [],8

gc_clr:                           /* leaf: clear the live record's +4..+43 and +48..+79 at a1. Uses d0, d1, a0 */
 mov a1,a0
 add 4,a0
 mov 19,d1
 clr d0
1:
 cmp 9,d1                         /* +44, the seed, stays */
 beq 2f
 mov d0,(a0)
2:
 add 4,a0
 add -1,d1
 bne 1b
 retf [],0

gc_mark:                          /* `call gc_mark,[d2,d3,a2,a3],32`, d0 = stage, d1 = guard. Uses d0, d1, a0, a1 */
 mov d0,d2
 mov d1,d3
 call gc_blk,[],8
 cmp 0,a1
 bne 2f
 call gc_pp,[],0
 cmp 0,a0
 beq 9f
 mov BLK,d0
 call ep7_malloc,[],4
 cmp 0,a0
 beq 9f
 mov a0,a1
 mov BLK/4,d1
 clr d0
1:
 mov d0,(a0)
 add 4,a0
 add -1,d1
 bne 1b
 mov 0x444e5247,d0                /* 'GRND' */
 mov d0,(80,a1)
 mov 1,d0
 movhu d0,(84,a1)
 mov 80,d0
 movhu d0,(88,a1)
 mov 8,d0
 movhu d0,(90,a1)
 mov GDIA,d0
 mov d0,(a1)
 call gc_pp,[],0
 mov a1,(1000,a0)
2:
 movbu (5,a1),d0
 cmp d0,d2
 bcs 9f
 movbu d2,(5,a1)
 movbu d3,(4,a1)
9:
 ret [d2,d3,a2,a3],32

gc_cnt:                           /* `call gc_cnt,[d2],12`, d0 = what to add to the counts. Uses d0, a0, a1 */
 mov d0,d2
 call gc_blk,[],8
 cmp 0,a1
 beq 9f
 movhu (8,a1),d0
 add d2,d0
 movhu d0,(8,a1)
9:
 ret [d2],12

/* gc_flag: as t1, every exit has its own id. Stage 1. a2 = params+12, a3 = capture. */
gc_flag:
 clr d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32    /* makes the block on the first capture */
 call gc_blk,[],8
 cmp 0,a1
 beq 2f
 movbu (6,a1),d0
 cmp 0,d0
 beq 1f
 call gc_sync,[d2,d3,a2,a3],32    /* committed by a half-press: last copy, next slot, clear. No file I/O here */
 movhu (86,a1),d0
 inc d0
 movhu d0,(86,a1)
 call gc_clr,[],0
1:
 movhu (86,a1),d0
 movhu d0,(62,a1)
 movhu (194,a3),d0
 movhu d0,(58,a1)
 movbu ({cap_mode},a3),d0
 movbu d0,(60,a1)
 movbu ({cap_profile},a3),d0
 movbu d0,(39,a1)
2:
 mov 0x100,d0
 call gc_cnt,[d2],12
 movhu (-2,a2),d0
 mov 0x01,d1
 cmp 11,d0
 bne 9f
 movhu (-4,a2),d0
 mov 0x02,d1
 cmp 0,d0
 bne 9f
 movbu ({cap_mode},a3),d0
 mov 0x03,d1
 cmp 11,d0
 bne 9f
 movbu ({cap_profile},a3),d0
 mov 0x04,d1
 add -2,d0
 cmp 3,d0
 bcc 9f
 movhu (194,a3),d0
 mov 0x05,d1
 cmp 0x2001,d0
 beq 9f
 mov 0x06,d1
 cmp 0x2006,d0
 beq 9f
 mov 0x07,d1
 cmp 0x1008,d0
 beq 9f
 mov 0x08,d1
 cmp 0x1006,d0
 beq 9f
 mov (a2),d0
 or 128,d0
 mov d0,(a2)
 clr d1
9:
 mov 1,d0
 call gc_mark,[d2,d3,a2,a3],32
 jmp ep7_bloom_flag

/* gc_gs: the work-list word (`calls`, a0 = job). Stages 2 and 3. No block: stock, nothing to report with. */
gc_gs:
 movm [d2,d3,a2,a3],(sp)
 add -16,sp
 mov a0,(4,sp)
 mov 0x10,d0
 call gc_cnt,[d2],12
 call gc_blk,[],8
