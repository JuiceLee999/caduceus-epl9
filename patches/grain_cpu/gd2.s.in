 movbu (11320,a0),d0
 movbu d0,(54,a1)
 movbu (11314,a0),d0
 movbu d0,(55,a1)
 movhu (11308,a0),d0
 movhu d0,(56,a1)
 add 6592,a0                      /* the first two buffer records in use, before the blend */
 mov a1,a2
 add 64,a2
 mov 48,d2
 mov 2,d3
3:
 mov (76,a0),d0
 cmp 0,d0
 beq 4f
 mov d0,(4,a2)
 mov (a0),d1
 mov d1,(a2)
 add 8,a2
 add -1,d3
 beq 1f
4:
 add 88,a0
 add -1,d2
 bne 3b
1:
 mov (4,sp),a0
 movbu (15490,a0),d0
 mov 0x10,d1
 cmp 0xb2,d0
 bne 80f
 movbu (15489,a0),d0
 mov 0x11,d1
 cmp 11,d0
 bne 80f
 movhu (20,a0),d0
 mov 0x12,d1
 cmp 0x1000,d0
 bne 80f
 mov (11308,a0),d0
 mov 0x13,d1
 cmp 11,d0
 bne 80f
 movbu (15488,a0),d0
 mov 0x14,d1
 add -1,d0
 beq 80f
 cmp 4,d0
 bcc 80f
 mov d0,(8,sp)
 mov 2,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 call gc_blk,[],8
 cmp 0,a1
 beq 90f
 mov (4,sp),a0
 mov ep7_sf,a1
 calls (a1)
 mov d0,(12,sp)
 call gc_blk,[],8
 mov (12,sp),d0
 movhu d0,(12,a1)
 exthu d0
 mov 0x15,d1
 cmp 0,d0
 bne 70f
 mov (4,sp),a0
 mov 4096,d0
 call ep7_bufidx,[d2],4
 exthu d0
 mov 0x16,d1
 cmp 48,d0
 bcc 70f
 asl 3,d0
 mov d0,d1
 add d0,d0
 add d0,d1
 asl 2,d0
 add d0,d1
 mov (4,sp),a0
 add 6592,a0
 add d1,a0
 mov a0,(4,sp)
 mov 3,d0
 clr d1
 call gc_mark,[d2,d3,a2,a3],32
 mov (4,sp),a0
 mov (8,sp),d0
 call gc_grain,[d2,d3,a2,a3],128
 bra 20f
70:
 mov 3,d0
 call gc_mark,[d2,d3,a2,a3],32
20:
