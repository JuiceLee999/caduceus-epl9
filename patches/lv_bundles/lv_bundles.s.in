/* E-P7 1.1 live-view bundle H/L (our own code; ep7-firmware). docs/LV_BUNDLES.md
 *
 * One hook: 0x603b02de, the COLOR selector's resume point right after the per-sector colour builder
 * 0x603b0068 (and after the bundles v0.2 `hl` routine, which ends with `jmp 0x603b02de`). Stock there:
 *     0x603b02de  f8 02 3c   mov (60,a2),d0
 *     0x603b02e1  f8 ec 02   btst 2,d0
 *     0x603b02e4  c8 54      beq 0x603b0338          <- we resume here, flags from the replayed btst
 *
 * lv runs for every COLOR (request key 11) development. It touches the builder's output only when ALL hold:
 *   - the request is embedded in a job (callback / record / parent guard, as `hl`);
 *   - the job has NO capture transport (marker != 0xB2): live view / movie / compact jobs. Capture jobs keep
 *     exactly what `hl` decided (lv returns at once), so stills are byte-identical to the base build;
 *   - the request key is 11 (COLOR; a MONO-colour run reaching 0x603b02de has key 12);
 *   - some COLOR slot (0..3) of the active table has flags bit1 (H/L) set: otherwise the property getter
 *     is never called and the output is stock;
 *   - the effective COLOR profile number (property 0xF6B1 = setting 908, read with the stock getter
 *     0x6005e971(key, 0, a0 = 0), the same read the capture population 0x602a85a2 does) is 1..4;
 *   - that slot has flags bit1 and all 24 UI values in -7..7.
 * Then the 12 records get hue/L exactly as `hl` writes them (same LUTs and permutation, read from the bundles
 * build's own tables), so a live-view build equals the capture build for the same profile and saturation.
 *
 * Registers: everything but d0 and PSW is restored (d0 is reloaded by the replayed `mov (60,a2),d0`).
 * MDR is saved/restored (every call sets it). (0,sp) is the saved-d0 slot: the call instructions write their
 * return word there. Stores: stack frame and the colour output records (context+12) only.
 */
 .am33_2
 .text
 .global _start
_start:
lv:
 add -32,sp
 mov d0,(0,sp)                       /* dead slot: call return words land here */
 mov d1,(4,sp)
 mov d2,(8,sp)
 mov d3,(12,sp)
 mov a0,(16,sp)
 mov a1,(20,sp)
 mov a3,(24,sp)
 mov mdr,d0
 mov d0,(28,sp)
 mov (4,a2),a1                       /* context+4 -> request */
 mov (a1),d0
 cmp {callback},d0
 bne out
 mov (4,a1),d0                       /* request+4 -> selected record */
 mov a1,a0
 add {rec_off},a0
 mov {n_rec},d2
scan:
 cmp a0,d0
 beq hit
 add {stride},a0
 add -1,d2
 bne scan
 bra out
hit:
 mov (a0),d1                         /* record+0 = parent job */
 mov a1,a0
 add -{req_in_job},a0                /* a0 = job */
 cmp a0,d1
 bne out
 movbu ({ext_magic},a0),d0
 cmp {magic},d0
 beq out                             /* capture job: the bundles `hl` routine owns it */
 movbu (8,a1),d1                     /* request key, as the selector builds it (0x603b02ab) */
 movbu (9,a1),d0
 movhu (10,a1),d2
 asl 24,d1
 asl 16,d0
 or d0,d1
 or d2,d1
 cmp 11,d1
 bne out                             /* COLOR only */
 clr d0
{tbl_base}
 movbu (31,a0),d0                    /* any COLOR slot with H/L on? (no getter call otherwise) */
 movbu (95,a0),d1
 or d1,d0
 movbu (159,a0),d1
 or d1,d0
 movbu (223,a0),d1
 or d1,d0
 btst 2,d0
 beq out
 mov {prop_profile},d0               /* effective COLOR profile number (setting 908) */
 clr d1
 mov 0,a0                            /* global lookup */
 call ep7_getter,[d2,d3],12          /* d0 = value (byte property, zero-extended) */
 add -1,d0
 cmp 4,d0
 bcc out                             /* unsigned: 0 and 5.. rejected */
{tbl_slot}
 movbu (31,a0),d0                    /* flags: bit1 = H/L enabled */
 btst 2,d0
 beq out
 clr d2                              /* validate hue[12], light[12] */
val:
 movbu (d2,a0),d0
 extb d0
 add {val_bias},d0
 cmp {val_n},d0
 bcc out                             /* outside -{val_bias}..{val_bias} -> stock */
 inc d2
 cmp 24,d2
 bne val
 mov (12,a2),a3                      /* context+12 -> colour output */
 add {hue_off},a3                    /* record 0 hue */
 clr d2                              /* physical record r */
rec:
 mov ep7_perm,a1
 movbu (d2,a1),d1                    /* UI index w = 2*(r%6)+r/6 */
 movbu (d1,a0),d0                    /* hue_ui[w] */
 extb d0
 add {val_bias},d0
 add d0,d0
 mov {hue_ref},a1
 movhu (d0,a1),d3
 movhu d3,(a3)
 add 12,d1
 movbu (d1,a0),d0                    /* light_ui[w] */
 extb d0
 add {val_bias},d0
 add d0,d0
 mov {light_ref},a1
 movhu (d0,a1),d3
 movhu d3,(4,a3)                     /* L at hue+4 */
 add 24,a3
 inc d2
 cmp 12,d2
 bne rec
out:
 mov (28,sp),d0
 mov d0,mdr
 mov (4,sp),d1
 mov (8,sp),d2
 mov (12,sp),d3
 mov (16,sp),a0
 mov (20,sp),a1
 mov (24,sp),a3
 add 32,sp
 mov (60,a2),d0                      /* displaced 0x603b02de */
 btst 2,d0                           /* displaced 0x603b02e1 */
 jmp ep7_resume                      /* 0x603b02e4 beq 0x603b0338 */
code_end:
