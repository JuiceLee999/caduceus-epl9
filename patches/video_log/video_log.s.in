 .am33_2
 .text
 .global _start
/* E-P7 1.1 video log (option A): extra condition in the movie-picture-mode derivation 0x6030df3d.
   Entry contract (stock, caller 0x6032641f: call 0x6030df3d,[a2],4):
     a0 = settings message A (A+352 MovPicModeType, A+353 MovPicMode, A+8, A+332 movie flag)
     a1 = &rec68[13]  (rec68[29] = picture mode from property 0x9481 -> (16,a1))
   Stock result byte (a1) becomes settings-record +925 (0 / 1 -> id 2000 / 2 -> id 2001).
   New: only when A+352 == 0 (stock type off) and A+332 == 1 (movie) and picture mode == {trig_log}
   (or {trig_flat}, if enabled) -> result 2 (1). Every other input runs the untouched stock body. */
_start:
vlog_hook:
 movbu (352,a0),d0                 /* stock MovPicModeType */
 cmp 0,d0
 bne stock                         /* stock type set: stock logic has priority */
 mov (332,a0),d0                   /* movie-mode flag (u32) */
 cmp 1,d0
 bne stock
 movbu (16,a1),d0                  /* rec68[29] = picture mode */
 cmp {trig_log},d0
 beq is_log
{flat_code}
 bra stock
is_log:
 mov 2,d0                          /* -> +925 = 2 -> effect id 2001 (log gamma 0x604f4478) */
 jmp ep7_store_ret                 /* stock tail: movbu d0,(a1); retf [a2],4 */
stock:
 mov 352,a2                        /* displaced stock instructions (5 bytes at 0x6030df3d) */
 add a0,a2
 jmp ep7_stock_body                /* 0x6030df42: movbu (a2),d0 ... */
