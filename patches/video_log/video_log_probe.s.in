 .am33_2
 .text
 .global _start
/* E-P7 1.1 video log, v0.14 fix + probe (patches/video_log/build_probe.py).
   FIX: the trigger picture mode is the message's movie picture mode A+354 (copied to record +294, the value the
   effect mapper 0x60316bc7 develops with and the movie makernote reports), not rec68[29] (property 0x9481).
   Camera evidence: from 12e on, the Muted clips carry picture mode 3 while the stills around them (and rec68[29],
   the probe's `s`) are COLOR; test 5 worked only because stills and movie were both Muted.
   Decision: +925 = 2 when A+352 == 0 (stock type off) && A+332 == 1 (movie) && A+354 == {trig_log};
   otherwise the untouched stock body (0x6030df42) runs. Everything else is probe.
   Entry (stock caller 0x6032641f: call 0x6030df3d,[a2],4): a0 = message A, a1 = &rec68[13]; a0/a1 preserved,
   d2/d3/a3 saved/restored with movm, MDR saved/restored (vrec calls set it), d0/d1/a2 free.
   Probe (heap block P only, when P is valid; never the image):
     P+704 + 12*i, i = 0..7: ring of records, appended when bytes 0..7 change:
       +0 A+352 t, +1 A+353 MovPicMode (setting 323), +2 A+354 movie pm, +3 rec68[29] (0x9481 pm),
       +4 A+8, +5 A+332 movie flag, +6 +925 before (rec68[13]), +7 +925 result, +8 call counter, +9 A+355, +10/11 0
     P+960 'VLGP', P+964 counter 0..99, P+965 trigger-pm seen, P+966 ring index, P+967 dump pending (movie call),
     P+968/972 record scratch, P+980 label "Vnn PP/SS mMtT R" + NUL (PP = A+354, SS = rec68[29], R = L log / S stock).
   vlog_txt: CALLS helper for look_extras ex_guide: a2 = P+980 when P + 'VLGP' are valid, else the stock text. */
 .macro TWO lo                     /* d0 = value -> two digits at (\lo,a2),(\lo+1,a2) ('?' tens if >= 100); d0,d1 */
 mov 0x30,d1
L91_\@:
 cmp 10,d0
 bcs L92_\@
 add -10,d0
 inc d1
 bra L91_\@
L92_\@:
 cmp 0x39,d1
 bls L93_\@
 mov 0x3f,d1
L93_\@:
 movbu d1,(\lo,a2)
 add 0x30,d0
 movbu d0,(\lo+1,a2)
 .endm
 .macro ONE at                     /* d0 = value -> one digit ('?' if > 9) */
 cmp 9,d0
 bls L94_\@
 mov 15,d0
L94_\@:
 add 0x30,d0
 movbu d0,(\at,a2)
 .endm
_start:
vlog_hook:
 movm [d2,d3,a3],(sp)
 add -8,sp                         /* (0,sp): return word of the vrec calls; (4,sp): MDR */
 mov mdr,d0
 mov d0,(4,sp)                     /* the caller's retf [a2],4 returns through MDR: keep it */
 clr d2                            /* d2 = resulting +925 (stock logic, for the probe) */
 movbu (352,a0),d0
 cmp 1,d0
 bne 1f
 movbu (353,a0),d0
 cmp 254,d0
 bne 2f
 mov 1,d2
 bra 1f
2:
 cmp 255,d0
 bne 1f
 movbu (8,a0),d0
 cmp 0,d0
 bne 1f
 mov 2,d2
1:
 clr d3                            /* d3 = 1: our log branch */
 movbu (352,a0),d0
 cmp 0,d0
 bne 3f
 mov (332,a0),d0
 cmp 1,d0
 bne 3f
 movbu (354,a0),d0
 cmp {trig_log},d0
 bne 3f
 mov 1,d3
 mov 2,d2
3:
 movhu ({state}),d0                /* ---- probe: P validation (as look_extras PVAL) */
 add -1,d0
 cmp {lim},d0
 bcc decide
 btst 3,d0
 bne decide
 mov d0,a2
 add {pool},a2
 mov (a2),d0
 cmp {bmagic},d0
 bne decide
 movbu (964,a2),d0                 /* call counter 0..99 */
 inc d0
 cmp 100,d0
 bcs 4f
 clr d0
4:
 movbu d0,(964,a2)
 TWO 981
 mov (332,a0),d0
 cmp 1,d0
 bne 5f
 movbu d0,(967,a2)                 /* dump pending: a movie call happened */
5:
 movbu (352,a0),d1                 /* record word 0 */
 movbu (353,a0),d0
 asl 8,d0
 or d0,d1
 movbu (354,a0),d0
 asl 16,d0
 or d0,d1
 movbu (16,a1),d0
 asl 24,d0
 or d0,d1
 mov d1,(968,a2)
 movbu (8,a0),d1                   /* record word 1 */
 mov (332,a0),d0
 and 255,d0
 asl 8,d0
 or d0,d1
 movbu (a1),d0
 asl 16,d0
 or d0,d1
 mov d2,d0
 asl 24,d0
 or d0,d1
 mov d1,(972,a2)
 movbu (966,a2),d0                 /* a3 = current ring record */
 call vrec,[],0
 mov (a3),d0
 mov (968,a2),d1
 cmp d0,d1
 bne 6f
 mov (4,a3),d0
 mov (972,a2),d1
 cmp d0,d1
 beq 7f
6:
 movbu (966,a2),d0                 /* new record */
 inc d0
 and 7,d0
 movbu d0,(966,a2)
 call vrec,[],0
 mov (968,a2),d0
 mov d0,(a3)
 mov (972,a2),d0
 mov d0,(4,a3)
 clr d0
 mov d0,(8,a3)
 movbu (355,a0),d0
 movbu d0,(9,a3)
7:
 movbu (964,a2),d0
 movbu d0,(8,a3)
 movbu (354,a0),d0                 /* label snapshot: pm == trigger, or while none was seen */
 cmp {trig_log},d0
 beq 8f
 movbu (965,a2),d0
 cmp 0,d0
 bne 9f
8:
 mov {w1},d0
 mov d0,(984,a2)                   /* "xx/x" */
 mov {w2},d0
 mov d0,(988,a2)                   /* "x mx" */
 mov {w3},d0
 mov d0,(992,a2)                   /* "tx x" */
 clr d0
 mov d0,(996,a2)
 movbu (354,a0),d0
 TWO 984
 movbu (16,a1),d0
 TWO 987
 mov (332,a0),d0
 ONE 991
 movbu (352,a0),d0
 ONE 993
 mov 0x53,d0                       /* 'S' */
 cmp 0,d3
 beq 10f
 mov 0x4c,d0                       /* 'L' */
10:
 movbu d0,(995,a2)
 movbu (354,a0),d0
 cmp {trig_log},d0
 bne 9f
 mov 1,d0
 movbu d0,(965,a2)
9:
 mov {w0},d0                       /* "V" + counter digits kept */
 movbu d0,(980,a2)
 mov 0x20,d0
 movbu d0,(983,a2)
 mov {vmagic},d0
 mov d0,(960,a2)
decide:
 mov (4,sp),d0
 mov d0,mdr
 add 8,sp
 cmp 0,d3
 beq stock
 movm (sp),[d2,d3,a3]
 mov 2,d0                          /* +925 = 2 -> effect id 2001 */
 jmp ep7_store_ret                 /* 0x6030df67: movbu d0,(a1); retf [a2],4 */
stock:
 movm (sp),[d2,d3,a3]
 mov 352,a2                        /* displaced stock instructions */
 add a0,a2
 jmp ep7_stock_body                /* 0x6030df42 */

vrec:                              /* d0 = index -> a3 = P+704+12*(d0&7); uses d0,d1 */
 and 7,d0
 mov d0,d1
 asl2 d1
 asl 3,d0
 add d1,d0
 add 704,d0
 mov d0,a3
 add a2,a3
 ret [],0

vlog_txt:                          /* CALLS entry; out a2; clobbers d0 */
 movhu ({state}),d0
 add -1,d0
 cmp {lim},d0
 bcc 20f
 btst 3,d0
 bne 20f
 mov d0,a2
 add {pool},a2
 mov (a2),d0
 cmp {bmagic},d0
 bne 20f
 mov (960,a2),d0
 cmp {vmagic},d0
 bne 20f
 add 980,a2
 rets
20:
 mov {ex_t_other},a2
 rets
code_end:
