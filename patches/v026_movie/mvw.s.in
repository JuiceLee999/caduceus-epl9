/* E-P7 1.1 v0.26 Movie slot + wheel (ep7-firmware, our own code). Drop with apply(spec, wheel=False). docs/MOVIE_COLOUR.md "Movie slot".
 * P2 = second 1024 B heap block, copy of P with the Movie slot in COLOR4's row (+224) and name (+592). P and P2: +{vm} 'EP7V', +{vp} P2, P2: +{vh} P's handle, +{va} / +{va}+4 ALL values.
 * While the wheel is open the loader state word holds P2's handle, so every editor routine (PVAL) works on P2 unchanged. mv_exit restores it. Stills never sees P2.
 *   mv_trig <- sd_back jmp (first half-press: film load, then MOVIE.BIN; every half-press: save when P2 is dirty). mv_gsave <- ed_trig's call ed_save: never saves P2 as BUNDLES.BIN.
 *   mv_lc <- Live Control INFO, row 111: GUI value 0 (Vivid), sid 1337 != 1, sid 44 == 1, P2 exists -> swap, stock route to key {ckey}.
 *   mv_get / mv_def / mv_set / mv_poly2: only while swapped. S ids (axis S / Film) -> P2 +257+s; ALL ids {all0} {all1} -> P2. 111 -> 64, 15272 -> 1646 at listed sites; 1648 -> 4.
 *   mv_sv, mv_tbl: the pipeline's S and slot reads. No P2 -> mv.s.in's gates miss -> stock Vivid.
 */
 .am33_2
 .text
 .global _start
_start:
 .macro SAVE5
 add -24,sp
 mov d0,(4,sp)
 mov d1,(8,sp)
 mov a0,(12,sp)
 mov a1,(16,sp)
 mov mdr,d0
 mov d0,(20,sp)
 mov (4,sp),d0
 .endm
 .macro REST5
 mov (20,sp),d0
 mov d0,mdr
 mov (4,sp),d0
 mov (8,sp),d1
 mov (12,sp),a0
 mov (16,sp),a1
 add 24,sp
 .endm
 .macro PV d, a, miss
 movhu ({state}),\d
 add -1,\d
 cmp {lim},\d
 bcc \miss
 btst 3,\d
 bne \miss
 mov \d,\a
 add {pool},\a
 mov (\a),\d
 cmp {bmagic},\d
 bne \miss
 .endm

/* -> a0 = P2 when swapped (d0 = 1), else d0 = 0. `call mv_sw,[d2],8`. Clobbers d2, a0. */
mv_sw:
 PV d2,a0,1f
 mov ({vm},a0),d2
 cmp {vmagic},d2
 bne 1f
 mov ({vp},a0),d2
 cmp a0,d2
 bne 1f
 mov 1,d0
 ret [d2],8
1:
 clr d0
 ret [d2],8

/* a2 = id (d0), a0 = P2 -> d0 = 0..11 when an S id on an S page, else -1. `call mv_si,[d2],8` */
mv_si:
 exthu d0
 add -1655,d0
 cmp 12,d0
 bcc 2f
 mov ({em},a0),d2
 cmp {emagic},d2
 bne 1f
 movbu ({axis},a0),d2
 cmp 1,d2
 beq 2f
 cmp 2,d2
 beq 2f
 cmp 4,d2
 beq 2f
1:
 ret [d2],8
2:
 mov -1,d0
 ret [d2],8

mv_lc:                            /* replays cmp 111,d3 / bne 0x60e5955f / mov (36,sp),d1 */
 cmp 111,d3
 beq 1f
 jmp ep7_lc_no
1:
 mov (36,sp),d1
 cmp 0,d1
 bne 2f
 mov (24,sp),d0                   /* sid 1337: stock blocks art variations in movie when 1 */
 cmp 1,d0
 beq 2f
 SAVE5
 add -4,sp
 mov 44,d0
 call ep7_sget,[],4
 add 4,sp
 cmp 1,d0
 bne 4f
 PV d0,a0,4f
 mov ({vm},a0),d0
 cmp {vmagic},d0
 bne 4f
 mov ({vp},a0),a1
 mov ({vh},a1),d0                 /* P2's own marks are written with P's */
 mov a1,d1
 add {neg_pool},d1
 inc d1
 mov {state},a0
 movhu d1,(a0)                    /* swap: P2's handle */
 add 24,sp
 mov {ckey},d0
 jmp ep7_lc_open
4:
 REST5
2:
 jmp ep7_lc_yes

mv_exit:                          /* state 7 exit (table word): swapped -> P's handle, then stock */
 SAVE5
 add -4,sp
 call mv_sw,[d2],8
 add 4,sp
 cmp 1,d0
 bne 1f
 mov ({vh},a0),d0
 mov {state},a0
 movhu d0,(a0)
1:
 REST5
 jmp ep7_exit

mv_get:                           /* CALLS: d0 id, a1 out, return address at (40,sp) after the saves */
 movm [d2,d3,a2,a3],(sp)
 SAVE5
 cmp 0,a1
 beq g_miss
 add -4,sp
 call mv_sw,[d2],8
 add 4,sp
 mov d0,d2
 mov a0,a2                        /* a2 = P2 when swapped */
 mov (4,sp),d0
 exthu d0
 mov (40,sp),d1
 cmp 1,d2
 beq 1f
 mov 15272,d2                     /* the wheel's exit runs after P is back: the 15272 sites stay covered, g_1646 gates them */
 cmp d2,d0
 bne g_miss
 bra g_cc1
1:
 cmp 111,d0
 bne g_cc
 mov mv_ra,a0
 mov {nra},d3
2:
 mov (a0),d2
 cmp d2,d1
 beq g_64
 add 4,a0
 add -1,d3
 bne 2b
 mov {pv_ra},d2                   /* Profile view: page 1 only (a3 = view at entry) */
 cmp d2,d1
 bne g_miss
 movbu (396,a3),d1
 cmp 1,d1
 bne g_miss
g_64:
 mov 64,d2
g_put:
 mov (16,sp),a1
 mov d2,(a1)
 mov (20,sp),d0
 mov d0,mdr
 mov (8,sp),d1
 mov (12,sp),a0
 add 24,sp
 movm (sp),[d2,d3,a2,a3]
 clr d0
 rets
g_cc:
 mov 15272,d2
 cmp d2,d0
 bne g_al
g_cc1:
 mov mv_ra2,a0
 mov {nra2},d3
2:
 mov (a0),d2
 cmp d2,d1
 beq g_1646
 add 4,a0
 add -1,d3
 bne 2b
 bra g_miss
g_1646:                           /* only in movie with the Movie slot loaded: stills and stock movie keep the Color Creator switch */
 add -4,sp
 call ep7_ccg,[],4
 add 4,sp
 cmp 1,d0
 bne g_miss
 mov 1646,d2
 bra g_put
g_al:
 mov ({va},a2),d2
 cmp {all0},d0
 beq g_put
 mov ({va}+4,a2),d2
 cmp {all1},d0
 beq g_put
 mov a2,a0
 add -4,sp
 call mv_si,[d2],8
 add 4,sp
 cmp 0,d0
 blt g_miss
 mov a2,a0
 add 257,a0
 movbu (d0,a0),d2
 extb d2
 bra g_put
g_miss:
 REST5
 movm (sp),[d2,d3,a2,a3]
 jmp ep7_get_next

mv_def:                           /* facade GetDefault word: S ids -> 0 */
 movm [d2,d3,a2,a3],(sp)
 SAVE5
 cmp 0,a1
 beq d_miss
 add -4,sp
 call mv_sw,[d2],8
 add 4,sp
 cmp 1,d0
 bne d_miss
 mov (4,sp),d0
 add -4,sp
 call mv_si,[d2],8
 add 4,sp
 cmp 0,d0
 blt d_miss
 clr d2
 mov (16,sp),a1
 mov d2,(a1)
 mov (20,sp),d0
 mov d0,mdr
 mov (8,sp),d1
 mov (12,sp),a0
 add 24,sp
 movm (sp),[d2,d3,a2,a3]
 clr d0
 rets
d_miss:
 REST5
 movm (sp),[d2,d3,a2,a3]
 jmp ep7_def_next

mv_set:                           /* call mv_set,[d2,d3,a2],16 at the GUI setter: d0 id, d1 value */
 SAVE5
 add -4,sp
 call mv_sw,[d2],8
 add 4,sp
 cmp 1,d0
 bne s_miss
 mov a0,a2                        /* a2 = P2 */
 mov (4,sp),d0
 exthu d0
 mov (8,sp),d1
 mov {all0},d2
 cmp d2,d0
 bne 1f
 mov d1,({va},a2)
 bra s_ref
1:
 mov {all1},d2
 cmp d2,d0
 bne 2f
 mov d1,({va}+4,a2)
 bra s_ref
2:
 mov a2,a0
 add -4,sp
 call mv_si,[d2],8
 add 4,sp
 cmp 0,d0
 blt s_miss
 mov (8,sp),d1
 cmp -5,d1
 blt s_bad
 cmp 5,d1
 bgt s_bad
 mov a2,a0
 add 257,a0
 movbu d1,(d0,a0)
 mov 1,d1
 movbu d1,({dirty},a2)
s_ref:
 mov (4,sp),d0                    /* redraw: the stock manager with the stored, unchanged value */
 add -4,sp
 call ep7_sget,[],4
 add 4,sp
 mov d0,d1
 mov (20,sp),d0
 mov d0,mdr
 mov (4,sp),d0
 mov (12,sp),a0
 mov (16,sp),a1
 add 24,sp
 jmp ep7_manager
s_bad:
 mov (20,sp),d0
 mov d0,mdr
 add 24,sp
 clr d0
 ret [d2,d3,a2],16
s_miss:
 REST5
 jmp ep7_set_next

mv_poly:                          /* call mv_poly,[],4 at 0x609330bf: d0 = 1648 */
 movm [d2,d3,a2,a3],(sp)
 SAVE5
 add -4,sp
 call mv_sw,[d2],8
 add 4,sp
 cmp 1,d0
 bne f_miss
 mov (4,sp),d0
 exthu d0
 cmp 1648,d0
 bne f_miss
 mov 4,d0
 mov d0,(4,sp)
 REST5
 movm (sp),[d2,d3,a2,a3]
 ret [],4
f_miss:
 REST5
 movm (sp),[d2,d3,a2,a3]
 jmp ep7_aget

mv_poly2:                         /* call mv_poly2,[],4 at 0x609330f9: d0 = sector id */
 movm [d2,d3,a2,a3],(sp)
 SAVE5
 add -4,sp
 call mv_sw,[d2],8
 add 4,sp
 cmp 1,d0
 bne h_miss
 mov a0,a2
 mov (4,sp),d0
 add -4,sp
 call mv_si,[d2],8
 add 4,sp
 cmp 0,d0
 blt h_miss
 mov a2,a0
 add 257,a0
 movbu (d0,a0),d0
 extb d0
 mov d0,(4,sp)
 REST5
 movm (sp),[d2,d3,a2,a3]
 ret [],4
h_miss:
 REST5
 movm (sp),[d2,d3,a2,a3]
 jmp ep7_poly_next

mv_sv:                            /* from mv_s: a1 = block, d1 = sector 0..11; frame [d2,d3],12 */
 mov ({vp},a1),a1
 add 257,a1
 movbu (d1,a1),d0
 extb d0
 ret [d2,d3],12

mv_tbl:                           /* call mv_tbl,[d2,d3],8 in lv / tone; d1 = marker only when mv_prof forced k */
 mov {pmark},d2
 cmp d2,d1
 beq 1f
 jmp ep7_tbl
1:
 PV d2,a0,2f
 mov ({vm},a0),d2
 cmp {vmagic},d2
 bne 2f
 mov ({vp},a0),a0
 add 224,a0
 ret [d2,d3],8
2:
 jmp ep7_tbl

mv_gsave:                         /* ed_trig's call ed_save,[d2,d3,a2,a3],24, a2 = block */
 mov ({vp},a2),d0
 cmp a2,d0
 bne 1f
 mov ({vm},a2),d0
 cmp {vmagic},d0
 bne 1f
 mov 2,d0
 ret [d2,d3,a2,a3],24
1:
 jmp ep7_save

mvw_end:
 .align 4
mv_ra:
{ra_words}
mv_ra2:
{ra2_words}
mvw_data_end:
