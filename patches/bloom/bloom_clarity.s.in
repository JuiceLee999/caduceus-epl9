/* E-P7 1.1 "COLOR bloom + clarity" patch (ep7-firmware, our own code). docs/CLARITY.md.
 *
 * Same hooks, guards and pipeline as bloom v0.4 (bloom.s.in; docs/BLOOM_HALATION.md section 6), plus
 * bundle effect_id 3 = clarity (local contrast, unsharp mask) on the same stock Soft Focus passes:
 *   reduce 160x120 -> upscale -> combiner 11: out = w*A + (1024-w)*B  (A = sharp, B = blurred [I]).
 * Bloom (id 1) returns w < 1024 (blur mixed in). Clarity (id 3) returns w > 1024, so B gets the negative
 * weight 1024-w: out = A + k*(A - blur(A)), k = (w-1024)/1024. The stock combiner-11 code packs 1024-w as
 * signed halfword pairs (+136) and a signed word (+140), the same encoding stock combiner 6 uses for its
 * -1024 B gain.
 *
 *   bloom_flag  0x603eabd7 (converter 0x603eab39): slot effect_id 1 OR 3, strength 1..5 -> job flag 0x80.
 *   bloom_w     0x6039fee8 (Soft Focus weight getter): effect 1 -> w_lut[s-1] (bloom, both combiners);
 *               effect 3 called from combiner 11 (return address {c11_ret}) -> c11_lut[s-1] (> 1024);
 *               effect 3 called from anywhere else (combiner 12, job classes 4-8, inputs/sign unproven)
 *               -> c12_lut[s-1] (1024 = no negative gain). Any failed check -> 600 (stock key 11).
 * Placement: section-2 FF tail (retired HSL v0.1 / grain v0.3 reservations), same section as both hooks.
 */
 .am33_2
 .text
 .global _start
_start:
 .set ART, {art}                  /* --art (v0.14): slot +46 Art Effect -> stock job flag (art.s.in) */
 .set HALO, {halo}                /* --halation (docs/HALATION_RED.md): effect_id 2 = red bloom, bloom colour (test13b) */

/* ---- entered by jmp from 0x603eabd7 inside 0x603eab39:
 *      a2 = params+12 (job flags word), a3 = capture; frame [a2,a3],20 untouched.
 *      params+8..11 = key bytes {b0, b1, hw} written by 0x603eaa04 just before.
 *      Free here (caller-saved, not read by the stock tail): d1, a0, a1. */
bloom_flag:
 movhu (-2,a2),d0                 /* key halfword (params+10) */
 cmp 11,d0
 bne bf_resume
 movhu (-4,a2),d0                 /* key bytes b0,b1 must be 0 */
 cmp 0,d0
 bne bf_resume
 movbu ({cap_mode},a3),d0         /* picture mode COLOR */
 cmp 11,d0
 bne bf_resume
 movbu ({cap_profile},a3),d0      /* profile 1..4 -> slot 0..3 */
 add -1,d0
 cmp 4,d0
 bcc bf_resume
{tbl_flag}
 .if ART
 jmp ep7_art                      /* Art Effect flag (art.s.in), returns to bf_art */
bf_art:
 .endif
 movbu ({f_effect},a0),d0
 cmp 1,d0                         /* effect_id 1 = bloom */
 beq bf_eff
 .if HALO
 cmp 2,d0                         /* effect_id 2 = red bloom (halation): same passes + the halo stub */
 beq bf_eff
 .endif
 cmp 3,d0                         /* effect_id 3 = clarity (same passes) */
 bne bf_resume
bf_eff:
 movbu ({f_strength},a0),d0
 add -1,d0
 cmp 5,d0                         /* strength 1..5 */
 bcc bf_resume
 mov (a2),d0
 or 128,d0                        /* job flag 0x80: Soft Focus pipeline */
 mov d0,(a2)
bf_resume:
 movbu (24054,a3),d0              /* replaced: stock 0x603eabd7 */
 cmp 0,d0                         /* replaced: stock 0x603eabdb */
 jmp ep7_bf_back                  /* 0x603eabdd: bne 0x603eabe7 */

/* ---- entered by jmp from 0x6039fee8 (called with call ...,[],0; a0 = combiner ctx,
 *      ctx+4 = request, ctx+52 = key). Exit like stock 0x6039ff29 (retf [],0; no
 *      mul/div, so MDR is intact). Stock clobbers d0/d1/a0/a1; so do we. */
bloom_w:
 mov (52,a0),a1                   /* replaced: key */
 cmp 11,a1
 bne bw_stock
 mov (4,a0),a1                    /* request */
 mov (a1),d0
 cmp {callback},d0
 bne bw_default
 mov (4,a1),d0                    /* request+4 -> selected record */
 mov a1,a0
 add {rec_off},a0
 mov {n_rec},d1
bw_scan:
 cmp a0,d0                        /* arithmetic match before any dereference */
 beq bw_hit
 add {stride},a0
 add -1,d1
 bne bw_scan
 bra bw_default
bw_hit:
 mov (a0),d1                      /* record+0 = parent job */
 mov a1,a0
 add -{req_in_job},a0             /* a0 = job */
 cmp a0,d1
 bne bw_default
 movbu ({ext_magic},a0),d0
 cmp {magic},d0
 bne bw_default
 movbu ({ext_mode},a0),d0
 cmp 11,d0
 bne bw_default
 movbu ({ext_profile},a0),d0
 add -1,d0
 cmp 4,d0
 bcc bw_default
{tbl_w}
 movbu ({f_effect},a0),d0
 .if HALO
 cmp 3,d0                         /* clarity here; bloom (1) / red bloom (2) + bloom colour: bw_tint (halo.s.in, */
 beq bw_cl                        /* sec 1; weights no other path returns key the halo stub), anything else 600 */
 jmp ep7_bw_tint
bw_cl:
 .else
 mov w_lut,a1
 cmp 1,d0                         /* bloom */
 beq bw_pick
 cmp 3,d0                         /* clarity */
 bne bw_default
 .endif
 mov c11_lut,a1
 cmp {c11_ret},d1                 /* d1 = MDR at entry = our return address */
 beq bw_pick
 mov c12_lut,a1                   /* not combiner 11: no negative gain */
bw_pick:
 movbu ({f_strength},a0),d0
 add -1,d0
 cmp 5,d0
 bcc bw_default
 add d0,d0
 movhu (d0,a1),d0                 /* mix weight (Q10) on the first input */
 retf [],0
bw_default:
 mov 600,d0                       /* stock result for key 11 (0x6039feeb, exthu) */
 retf [],0
bw_stock:
 mov 600,d0                       /* replaced */
 jmp ep7_bw_back                  /* 0x6039feee: cmp 0x01010065,a1 */
 .balign 2
w_lut:                            /* bloom: strength 1..5 -> w (< 1024) */
 .hword {w_lut}
c11_lut:                          /* clarity, combiner 11: strength 1..5 -> w (> 1024) */
 .hword {c11_lut}
c12_lut:                          /* clarity, any other caller: 1024 (A only) */
 .hword {c12_lut}
