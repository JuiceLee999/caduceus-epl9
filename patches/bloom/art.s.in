/* E-P7 1.1 COLOR Art Effect (v0.14; ep7-firmware, our own code). docs/HALATION_RED.md section 11.
 * Dead EVF gamma step-9 R table 0x601e1d3c (only refs: step-table words 0x601e3d10/14/18, build-checked).
 *
 *   art <- `jmp` from bloom_flag (bloom_clarity.s.in) right after the slot lookup, i.e. only for a still converter
 *          call 0x603eab39 with params key 11, key bytes 0, capture picture mode COLOR and profile 1..4 (the bloom
 *          gates); a0 = slot entry (SD-loaded or flashed table), a2 = params+12 (job flag word); MDR already restored.
 *          Slot byte +{f_art} = 1..5 applies exactly the stock converter's Art Effect flag update (jump table 0x6053dd00):
 *            1 Star Light (stock id 5): |= 0x40          2 Pin Hole (id 2): |= 0x400
 *            3 Blur (id 6, Diorama V): &= ~0x300, |= 0x100
 *            4 White Edge (id 4): |= 0x2000               5 Frame (id 3): |= 0x8000
 *          Any other value (0 = off, erased table 0xFF): nothing. Returns to bloom_flag with a0 unchanged.
 *          Clobbers d0, d1, a1 (free at the bloom_flag site).
 */
 .am33_2
 .text
 .global _start
_start:
art:
 movbu ({f_art},a0),d0
 add -1,d0
 cmp 5,d0
 bcc 1f
 asl 3,d0
 mov art_tab,a1
 add d0,a1
 mov (a2),d0
 mov (a1),d1
 and d1,d0
 mov (4,a1),d1
 or d1,d0
 mov d0,(a2)
1:
 jmp ep7_art_back
 .balign 4
art_tab:                          /* (and, or) per art 1..5 */
 .long 0xffffffff, 0x40
 .long 0xffffffff, 0x400
 .long 0xfffffcff, 0x100
 .long 0xffffffff, 0x2000
 .long 0xffffffff, 0x8000
art_end:
