/* E-P7 1.1 read-only blur-buffer probe (v0.14; ep7-firmware, our own code). docs/HALATION_RED.md section 10d.
 * Dead EVF gamma step-9 R/G/B tables 0x601e1d3c..0x601e203c (only refs: step-table words 0x601e3d10/14/18, build-checked).
 *
 * Purpose: map the layout of the 160x120 Soft Focus reduce buffer 0x1060 (format 0x0305, 4 B/px) and whether the
 * reduce has finished when the blend is set up. Nothing in the image pipeline changes: both hooks replay their stock
 * instructions; the only stores are into the record R below (heap) and the stack.
 *
 *   bp_set <- jmp at 0x6035caad (Soft Focus blend setup 0x6035ca31; a2 = request, a3 = 0x1000 entry, (8,sp) = job,
 *             d3 live). Red-tint bloom jobs only (job marker / mode 11 / profile 1..4; slot effect 1 tint 1 or effect 2
 *             tint 0/1). Writes R: +8 job, +12 flags (bit0 0x1060 found), +16..31 descriptor words +0/+8/+12/+16 of
 *             0x1060, +32..71 five sample points x 8 B (2 px) at (w/2,h/2), (w/4,h/4), (3w/4,h/4), (w/4,3h/4),
 *             (3w/4,3h/4), +4 u8 setup counter, then +0 'EP7Q' last. Replays movhu (12,a3),d1 / movhu (14,a3),d2.
 *   bp_cb  <- jmp at 0x6035cbaa (blend callback entry, a0 = job; 0x1060 is still allocated here, after the blend).
 *             Replays movm [d2,a2,a3],(sp) / add -8,sp first. If R+0 == 'EP7Q' and R+8 == job: the same five points
 *             into R+72..111 and R+5 u8 callback counter. Equal setup / callback samples = the reduce was done at setup.
 *   R = L + {r_off}: L = P+1016 (film page block, valid with P+1020 'EP7F'), P = the SD loader v3 heap block (valid h,
 *       P+0 'EP7B'). L must lie in the class-1 pool with room for R. No P / no L -> nothing recorded.
 * Reads of the buffer only when its address is 4-aligned and w, h, stride are 1..4096.
 */
 .am33_2
 .text
 .global _start
_start:

bp_set:
 mov (8,sp),a0
 movbu ({ext_magic},a0),d0
 cmp {magic},d0
 bne s_out
 movbu ({ext_mode},a0),d0
 cmp 11,d0
 bne s_out
 movbu ({ext_profile},a0),d0
 add -1,d0
 cmp 4,d0
 bcc s_out
 call ep7_tbl_idx,[d2,d3],8       /* a0 = slot d0 (clobbers a0, MDR only) */
 movbu ({f_tint},a0),d1
 movbu ({f_effect},a0),d0
 cmp 1,d0
 beq 1f
 cmp 2,d0
 bne s_out
 cmp 0,d1                         /* effect 2 with tint 0 = red */
 beq 2f
1:
 cmp 1,d1
 bne s_out
2:
 call bp_rec,[],0                 /* a1 = R or 0 */
 cmp 0,a1
 beq s_out
 mov (8,sp),a0
 mov a0,(8,a1)                    /* R+8 job */
 clr d0
 mov d0,(12,a1)
 add 6592,a0
 call p_find,[],0                 /* a0 = 0x1060 entry or 0 */
 cmp 0,a0
 beq 3f
 mov 1,d0
 mov d0,(12,a1)
 mov (a0),d0
 mov d0,(16,a1)
 mov (8,a0),d0
 mov d0,(20,a1)
 mov (12,a0),d0
 mov d0,(24,a1)
 mov (16,a0),d0
 mov d0,(28,a1)
 mov a1,d0
 add 32,d0
 call bp_pts,[d2,d3,a2,a3],16     /* a0 = entry, d0 = dest; clobbers a1 */
 call bp_rec,[],0
3:
 movbu (4,a1),d0
 inc d0
 movbu d0,(4,a1)
 mov 1,d0
 movbu d0,(6,a1)                  /* LOGDBG pending */
 mov {qmagic},d0
 mov d0,(a1)                      /* 'EP7Q' last */
s_out:
 movhu (12,a3),d1                 /* replayed: 0x6035caad */
 movhu (14,a3),d2                 /* replayed: 0x6035cab0 */
 jmp ep7_bs_back                  /* 0x6035cab3 */

bp_cb:
 movm [d2,a2,a3],(sp)             /* replayed: 0x6035cbaa */
 add -8,sp                        /* replayed: 0x6035cbac */
 mov a0,a2                        /* job (a0 is the stock argument: restored below) */
 call bp_rec,[],0
 cmp 0,a1
 beq c_out
 mov (a1),d0
 cmp {qmagic},d0
 bne c_out
 mov (8,a1),d0
 cmp a2,d0
 bne c_out
 mov a2,a0
 add 6592,a0
 call p_find,[],0
 cmp 0,a0
 beq 4f
 mov a1,d0
 add 72,d0
 call bp_pts,[d2,d3,a2,a3],16
 call bp_rec,[],0
4:
 movbu (5,a1),d0
 inc d0
 movbu d0,(5,a1)
 mov 1,d0
 movbu d0,(6,a1)                  /* LOGDBG pending */
c_out:
 mov a2,a0
 jmp ep7_bc_back                  /* 0x6035cbaf */

/* ---- LOGDBG.TXT (patches/video_log vlog_dump): called with `call ep7_bq_gate,[],4`, a2 = P (valid).
 * d0 = 1 when the video-log batch is pending (P+960 'VLGP', P+967 != 0) or the bloom record is pending (R 'EP7Q',
 * R+6 != 0); both flags are cleared (one attempt). Clobbers d0, d1, a1. */
bq_gate:
 clr d1
 mov (960,a2),d0
 cmp {vmagic},d0
 bne 1f
 movbu (967,a2),d0
 cmp 0,d0
 beq 1f
 clr d0
 movbu d0,(967,a2)
 mov 1,d1
1:
 call bp_rec,[],0
 cmp 0,a1
 beq 2f
 mov (a1),d0
 cmp {qmagic},d0
 bne 2f
 movbu (6,a1),d0
 cmp 0,d0
 beq 2f
 clr d0
 movbu d0,(6,a1)
 mov 1,d1
2:
 mov d1,d0
 ret [],4

/* `call ep7_bq_dump,[d2,a2],12`, a0 = text write pointer -> a0 advanced. When R holds 'EP7Q': 10 lines
 * "Qk: b0 .. b11" = R+0..R+119 in hex. Clobbers d0, d1, d3, a1 (d2, a2 restored by the ret). */
bq_dump:
 call bp_rec,[],0
 cmp 0,a1
 beq 9f
 mov (a1),d0
 cmp {qmagic},d0
 bne 9f
 clr d2
1:
 mov 0x51,d0                      /* 'Q' */
 movbu d0,(a0)
 mov d2,d0
 add 0x30,d0
 movbu d0,(1,a0)
 mov 0x3a,d0
 movbu d0,(2,a0)
 add 3,a0
 mov 12,d3
2:
 mov 0x20,d0
 movbu d0,(a0)
 movbu (a1),d1
 mov d1,d0
 lsr 4,d0
 add 0x30,d0
 cmp 0x3a,d0
 bcs 3f
 add 7,d0
3:
 movbu d0,(1,a0)
 mov d1,d0
 and 15,d0
 add 0x30,d0
 cmp 0x3a,d0
 bcs 4f
 add 7,d0
4:
 movbu d0,(2,a0)
 add 3,a0
 inc a1
 add -1,d3
 bne 2b
 mov 13,d0
 movbu d0,(a0)
 mov 10,d0
 movbu d0,(1,a0)
 add 2,a0
 inc d2
 cmp 10,d2
 bne 1b
9:
 ret [d2,a2],12

/* -> a1 = R (L + {r_off}) or 0. Clobbers d0. */
bp_rec:
 movhu ({state}),d0
 add -1,d0
 cmp {lim},d0
 bcc 9f
 btst 3,d0
 bne 9f
 mov d0,a1
 add {pool},a1                    /* P */
 mov (a1),d0
 cmp {bmagic},d0
 bne 9f
 mov (1020,a1),d0
 cmp {fmagic},d0
 bne 9f
 mov (1016,a1),d0                 /* L */
 btst 3,d0
 bne 9f
 cmp {pool},d0
 bcs 9f
 cmp {l_max},d0
 bhi 9f
 add {r_off},d0
 mov d0,a1
 ret [],0
9:
 mov 0,a1
 ret [],0

/* a0 = job buffer table (48 x 88 B, id at +76) -> a0 = entry of 0x1060 or 0. Clobbers d0, d1. */
p_find:
 mov 48,d1
5:
 mov (76,a0),d0
 cmp {mask_id},d0
 beq 6f
 add 88,a0
 add -1,d1
 bne 5b
 mov 0,a0
6:
 ret [],0

/* a0 = buffer descriptor, d0 = dest (5 x 8 B). Five sample points; nothing stored if the descriptor is implausible.
 * Uses d0-d3, a2, a3 (saved by the call), a0, a1, MDR. */
bp_pts:
 mov d0,a3                        /* dest */
 mov (a0),d0
 btst 3,d0
 bne 8f
 mov d0,a2                        /* base */
 movhu (10,a0),d1                 /* stride (px) */
 movhu (12,a0),d2                 /* w */
 movhu (14,a0),d3                 /* h */
 mov d1,d0
 add -1,d0
 cmp 4096,d0
 bcc 8f
 mov d2,d0
 add -1,d0
 cmp 4096,d0
 bcc 8f
 mov d3,d0
 add -1,d0
 cmp 4096,d0
 bcc 8f
 mov bp_tab,a0
7:
 movbu (a0),d0                    /* fx (quarters) */
 mulu d2,d0
 lsr 2,d0
 mov d0,a1                        /* x */
 movbu (1,a0),d0                  /* fy */
 mulu d3,d0
 lsr 2,d0
 mulu d1,d0                       /* y * stride */
 add a1,d0
 asl 2,d0                         /* 4 B/px */
 add a2,d0
 mov d0,a1
 mov (a1),d0
 mov d0,(a3)
 mov (4,a1),d0
 mov d0,(4,a3)
 add 8,a3
 add 2,a0
 movbu (a0),d0
 cmp 0,d0
 bne 7b
8:
 ret [d2,d3,a2,a3],16
 .balign 2
bp_tab:
 .byte 2,2, 1,1, 3,1, 1,3, 3,3, 0,0
