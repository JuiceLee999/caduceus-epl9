/* E-P7 1.1 bloom colour (tinted bloom) stubs, test13b (ep7-firmware, our own code). docs/HALATION_RED.md section 8.
 * Section 1 0x601e263c (dead EVF gamma step-6 R table; only ref: the step-table word 0x601e3ce0, build-checked).
 *
 *   bw_tint <- `jmp` from bloom_w (bloom_clarity.s.in) for slot effect_id 1 (bloom) and 2 (red bloom, legacy), with
 *              a0 = slot entry, d0 = effect_id, MDR = the getter's return address (restored by bloom_w).
 *              tint = slot +{f_tint} (0 neutral, 1 red, 2 amber, 3 warm, 4 cool; effect 2 with tint 0 = red),
 *              s = strength 1..5 -> w = t_w[5 tint + s - 1]. Row 0 is the plain bloom table (stock-identical
 *              banks); rows 1..4 are w+1..w+4, weights no other path returns (bloom 942..666, clarity >= 1100,
 *              Soft Focus 760..200, 600, 1024; build-checked). Bad strength / tint / effect -> 600 (stock key 11).
 *              Exit `retf [],0` like the stock getter. Clobbers d0, d1, a0 (stock clobbers d0/d1/a0/a1).
 *   halo    <- `jmp halo` at 0x603a04e8, the tail of combiner-11 handler 0x603a049e: d1 = b | b<<16 (b = 1024-w),
 *              d2 = w (exthu), d3 = b, a3 = bank, frame [d2,d3,a2,a3],20. It replays the two replaced stores
 *              (+136 = d1, +140 = d3). Only when w is in rows 1..4 of t_w it rewrites the chroma gains of tint t:
 *                ch0 (Y,  +136 lo / +92 lo): B = b, A = w                   (as bloom)
 *                ch1 (Cb, +136 hi / +92 hi): B = min(kcb[t] b / 8, 1024), A = 1024 - B
 *                ch2 (Cr, +140    / +96   ): B = min(kcr[t] b / 8, 1024), A = 1024 - B
 *              Channel order Y, Cb, Cr is [I] (HALATION_RED section 4). Gains stay in 0..1024 and sum to 1024.
 *              Exit `ret [d2,d3,a2,a3],20` as the stock tail at 0x603a04f0, d0 = b << 16 (as stock), a0 untouched.
 * Stores: the bank (a3) only. No mul/div, no setlb/Lcc, no calls.
 */
 .am33_2
 .text
 .global _start
_start:

bw_tint:
 add -1,d0
 cmp 2,d0
 bcc t_def                        /* effect not 1 or 2 */
 movbu ({f_tint},a0),d1
 cmp 0,d0
 beq 1f                           /* bloom: its own tint (0 = neutral) */
 cmp 0,d1
 bne 1f
 mov 1,d1                         /* red bloom (effect 2) without a tint: red */
1:
 cmp 5,d1
 bcc t_def
 mov d1,d0
 asl 3,d0
 add d1,d1
 add d1,d0                        /* 10 tint (bytes) */
 movbu ({f_strength},a0),d1
 add -1,d1
 cmp 5,d1
 bcc t_def
 add d1,d1
 add d1,d0
 mov t_w,a0
 movhu (d0,a0),d0                 /* mix weight (Q10) on the first input */
 retf [],0
t_def:
 mov 600,d0                       /* stock result for key 11 */
 retf [],0

/* d0 = min(k * b / 8, 1024); k in d1 (u8), b in d3. Uses d0, d1. */
 .macro KMUL
 clr d0
 cmp 0,d1
 beq 92f
91:
 add d3,d0
 add -1,d1
 bne 91b
92:
 lsr 3,d0
 cmp 1024,d0
 bls 93f
 mov 1024,d0
93:
 .endm

halo:
 mov d1,(136,a3)                  /* replayed: 0x603a04e8 */
 mov d3,(140,a3)                  /* replayed: 0x603a04ec */
 mov t_w+10,a2                    /* rows 1..4 */
 mov t_k,a1
2:
 mov 5,d1
3:
 movhu (a2),d0
 cmp d0,d2
 beq h_go
 add 2,a2
 add -1,d1
 bne 3b
 add 2,a1
 cmp t_k,a2
 bne 2b
 bra h_out                        /* not a tinted weight: exactly the stock tail */
h_go:
 movbu (1,a1),d1
 KMUL                             /* d0 = B_Cr */
 mov d0,(140,a3)
 mov 1024,d1
 sub d0,d1
 mov d1,(96,a3)                   /* A_Cr */
 movbu (a1),d1
 KMUL                             /* d0 = B_Cb */
 mov d0,d1
 asl 16,d1
 or d3,d1
 mov d1,(136,a3)                  /* B ch0 = b | B_Cb << 16 */
 mov 1024,d1
 sub d0,d1
 asl 16,d1
 or d2,d1
 mov d1,(92,a3)                   /* A ch0 = w | (1024 - B_Cb) << 16 */
h_out:
 mov d3,d0
 asl 16,d0                        /* stock d0 at the tail */
 ret [d2,d3,a2,a3],20

 .balign 2
t_w:                              /* [tint 0..4][strength 1..5] */
 .hword {t_w}
t_k:                              /* tint 1..4: kcb, kcr in eighths */
 .byte {t_k}
t_end:
