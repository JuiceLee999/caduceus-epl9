/* E-P7 1.1 per-profile Blacks / Whites (our own code; ep7-firmware). docs/TONE_ENDS.md §3, §6
 *
 * Hook: 0x603b14ff in the development stage list 0x603b1466, right after the luminance-LUT builder 0x603b0a70:
 *     stock  0x603b14ff  f1 ec            mov d3,a0
 *            0x603b1501  cd 65 f7 f0 48   call 0x603b0c66,[d2,d3,a2,a3],72
 *     new    0x603b14ff  dd <rel32> f0 48 call tone,[d2,d3,a2,a3],72
 * The 7-byte d32 call has the stock register list and frame and the same return address (0x603b1506) as the
 * stock call, so `tone` runs inside the frame the stock call would have made, then replays `mov d3,a0` and
 * jumps to 0x603b0c66, which returns straight to 0x603b1506. Return word, saved registers and MDR are what the
 * stock call leaves.
 *
 * d3 = development context C (stage-list callee-saved); C+4 = request R, C+12 = colour output O;
 * O+2608 = active 256 x u16 luminance LUT (10-bit), O+2612 = the job's own 512-B LUT buffer.
 *
 * Remap only when ALL hold (else nothing is stored but our own stack frame):
 *   - O+2608 != 0 (bloom/mask passes have no LUT);
 *   - the request is embedded in a job (callback / record / parent guard, as the bundles `hl` / `lv` readers);
 *   - request key == 11 (COLOR);
 *   - profile: capture job (marker 0xB2): job picture mode == 11 and profile = job+15488 (as `hl`);
 *              otherwise (live view): some COLOR slot has Blacks/Whites != 0, then the getter 0x6005e971(0xF6B1)
 *              (as `lv`; never called when every COLOR slot is 0);
 *   - profile 1..4 -> COLOR slot 0..3 of the active table ({tbl_note});
 *   - slot +47 Blacks / +48 Whites (s8): a value outside -5..5 counts as 0; both 0 -> nothing.
 *   - idempotent (v0.19b; the LV context persists across developments): O+2608 == O+2612 is remapped only when
 *     the builder rebuilt it this pass (R+1524 art override, or C+60 & 0x8268063e, the builder's own test);
 *     otherwise it already holds remap(base) from the last rebuild and is left alone (no compounding).
 * Then, like the stock tone-control step: copy the active LUT to O+2612 if it is not there, remap O+2612 in
 * place (tools/ep7_tone.py remap(), bit-exact), O+2608 = O+2612, clear O+4 bit 8.
 *
 * Registers: all restored (a0 = C as the replayed mov sets it). MDR restored. Stores: our stack frame,
 * O+2612..O+3123, O+2608, O+4.
 */
 .am33_2
 .text
 .global _start
_start:
tone:
 add -48,sp
 mov d0,(0,sp)
 mov d1,(4,sp)
 mov d2,(8,sp)
 mov d3,(12,sp)
 mov a1,(16,sp)
 mov a2,(20,sp)
 mov a3,(24,sp)
 mov mdr,d0
 mov d0,(28,sp)
 mov d3,a2                           /* a2 = context C */
 mov (12,a2),a3                      /* a3 = colour output O */
 mov (2608,a3),d0
 cmp 0,d0
 beq out                             /* no LUT */
 mov a3,d1                           /* v0.19b idempotence: O+2608 == O+2612 holds a pristine base only when */
 add 2612,d1                         /* the builder rebuilt it this pass (art override R+1524, or a C+60 bit of */
 cmp d1,d0                           /* its mask 0x8268063e); otherwise it is last pass's output (ours): keep it */
 bne fresh
 mov (4,a2),a1
 mov (1524,a1),d1
 cmp 0,d1
 bne fresh
 mov (60,a2),d1
 and 0x8268063e,d1
 beq out
fresh:
 mov (4,a2),a1                       /* request R */
 mov (a1),d0
 cmp {callback},d0
 bne out
 mov (4,a1),d0                       /* R+4 -> selected record */
 mov a1,a0
 add {rec_off},a0
 mov {n_rec},d2
scan:
 cmp a0,d0
 beq hit
 add {stride},a0
 add -1,d2
 bne scan
 bra out
hit:
 mov (a0),d1                         /* record+0 = parent job */
 mov a1,a0
 add -{req_in_job},a0                /* a0 = job */
 cmp a0,d1
 bne out
 mov (8,a1),d0                       /* request key (R+8 u8, +9 u8, +10 u16) == 11 <=> word == 0x000b0000 */
 cmp 0xb0000,d0
 bne out                             /* COLOR only */
 movbu ({ext_magic},a0),d0
 cmp {magic},d0
 bne live
 movbu ({ext_mode},a0),d0            /* capture job: as `hl` */
 cmp 11,d0
 bne out
 movbu ({ext_profile},a0),d0
 bra prof
live:
 clr d0
{tbl_slot}
 clr d1                              /* any COLOR slot with Blacks/Whites != 0? */
 mov 4,d2
any:
 movbu (47,a0),d0
 or d0,d1
 movbu (48,a0),d0
 or d0,d1
 add 64,a0
 add -1,d2
 bne any
 cmp 0,d1
 beq out                             /* no getter call */
 mov {prop_profile},d0
 clr d1
 mov 0,a0                            /* global lookup */
 call ep7_getter,[d2,d3],12          /* d0 = effective COLOR profile number */
prof:
 add -1,d0
 cmp 4,d0
 bcc out                             /* unsigned: 0 and 5.. rejected */
{tbl_slot}
 jmp remap                           /* piece B: dead EVF step-13 B table */
out:
 mov (28,sp),d0
 mov d0,mdr
 mov (0,sp),d0
 mov (4,sp),d1
 mov (8,sp),d2
 mov (12,sp),d3
 mov (16,sp),a1
 mov (20,sp),a2
 mov (24,sp),a3
 add 48,sp
 mov d3,a0                           /* displaced 0x603b14ff */
 jmp ep7_next                        /* 0x603b0c66; returns to 0x603b1506 */
code_end:

/* ---------------------------------------------------------------- piece B (0x601e133c)
 * Entered from piece A with a0 = COLOR slot, a2 = C, a3 = O and the frame of piece A on the stack. */
 .section .tone_b,"ax"
remap:
 movbu (47,a0),d0                    /* Blacks */
 extb d0
 add 5,d0
 cmp 11,d0
 bcs bok
 mov 5,d0                            /* out of range -> 0 */
bok:
 add -5,d0
 movbu (48,a0),d1                    /* Whites */
 extb d1
 add 5,d1
 cmp 11,d1
 bcs wok
 mov 5,d1
wok:
 add -5,d1
 mov d0,d2
 or d1,d2
 beq bout                            /* B = W = 0: no copy, no store */
 clr d2                              /* lo  = 8B   (B > 0) */
 clr d3                              /* cB  = -12B (B < 0) */
 cmp 0,d0
 blt bneg
 mov d0,d2
 asl 3,d2
 bra bdone
bneg:
 mov -12,d3
 mul d0,d3
bdone:
 mov d2,(32,sp)                      /* lo */
 mov d3,(36,sp)                      /* cB */
 mov 1023,d3                         /* hi = 1023 + 10W (W < 0) */
 clr d2                              /* cW = 12W (W > 0) */
 cmp 0,d1
 blt wneg
 mov 12,d2
 mul d1,d2
 bra wdone
wneg:
 mov 10,d0
 mul d1,d0
 add d0,d3
wdone:
 mov d2,(40,sp)                      /* cW */
 mov (32,sp),d0
 sub d0,d3                           /* span = hi - lo */
 mov 1025,d0
 mul d0,d3
 mov d3,(44,sp)                      /* K = span * 1025 */
 mov a3,a0
 add 2612,a0                         /* a0 = O+2612 */
 mov (2608,a3),a1
 cmp a0,a1
 beq nocopy
 clr d1
copy:
 movhu (d1,a1),d0
 movhu d0,(d1,a0)
 add 2,d1
 cmp 512,d1
 bne copy
 mov a0,(2608,a3)                    /* O+2608 = O+2612 */
nocopy:
 mov (4,a3),d0
 and -257,d0                         /* clear O+4 bit 8, as the stock tone step does */
 mov d0,(4,a3)
 mov a0,a1
 add 512,a1                          /* end */
 clr d3                              /* running max */
loop:
 movhu (a0),d0
 cmp 1023,d0
 bls c0
 mov 1023,d0
c0:
 mov 1023,d1                         /* toe crush: y -= cB * ((t*t>>10)*t>>10) >> 10, t = 1023 - y */
 sub d0,d1
 mov d1,d2
 mul d1,d2
 lsr 10,d2
 mul d1,d2
 lsr 10,d2
 mov (36,sp),d1
 mul d1,d2
 lsr 10,d2
 sub d2,d0
 bge c1
 clr d0
c1:
 mov d0,d2                           /* shoulder push: y += cW * ((y*y>>10)*y>>10) >> 10 */
 mul d0,d2
 lsr 10,d2
 mul d0,d2
 lsr 10,d2
 mov (40,sp),d1
 mul d1,d2
 lsr 10,d2
 add d2,d0
 cmp 1023,d0
 bls c2
 mov 1023,d0
c2:
 mov (44,sp),d1                      /* y = lo + (y*K + 0xFFFFF) >> 20 */
 mul d1,d0
 add 1048575,d0
 lsr 20,d0
 mov (32,sp),d1
 add d1,d0
 cmp d3,d0                           /* running max */
 bcc c3
 mov d3,d0
c3:
 mov d0,d3
 movhu d0,(a0)
 add 2,a0
 cmp a1,a0
 bne loop
bout:
 jmp out
code_b_end:
