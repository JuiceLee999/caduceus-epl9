/* E-P7 1.1 mono film presets, part B: guide label + tables (ep7-firmware, our own code). docs/MONO_PRESETS.md.
 * Section 1, dead EVF gamma step-11 R/G/B + step-10 R tables 0x601e173c..0x601e1b3c (only refs: step-table words
 * 0x601e3d30/34/38, 0x601e3d20).
 *
 * v0.15 picker label. The MONO filter and shading pages of the Profile view (vtable 0x61189ba8, update 0x60e26ab0)
 * leave their guide slot empty; it is view+186 ((404,view) == 1) else view+260, a 74-byte label
 * (u16 kind, -, u16 id, u16 style, text[33]).
 *   mp_lbl1 <- `call` at 0x60e27209 (page 1 MONO filter; was `mov (8,sp),a0; mov a0,a1; call 0x60e26789,[],0`), view = d3
 *   mp_lbl2 <- `call` at 0x60e275c1 (page 2 shading; was `mov a2,a0; mov a2,a1; call 0x60e26789,[],0`), view = d2
 * 0x60e26789 is `mov (84,a1),d0; retf`, replayed at the end. With a card table and a MONO picture mode (view+400
 * 57/58/59/65 -> m) the slot becomes kind-5 text:
 *   Film page (P+{mmark} 'EP7M' and P+{mpage} == 1):  "Film: <name>[*]"  or "Film: Custom" (no preset name)
 *   stock page:                                         "<name>[*][INFO]" or "Film[INFO]"
 * <name> = the preset whose 16-byte name equals the MONO slot name P+608+16m (needs 'EP7N'). '*' = one of the
 * preset's {nf} settings now reads (facade GetValue, low byte) different from the preset value.
 * Anything else: the slot stays as the page left it. Keeps d1/d2/d3/a2/a3/sp; mdr is reloaded from the stock
 * call's return word before the retf. Stores: the view's label (heap) and our own stack only.
 */
 .am33_2
 .text
 .global _start
_start:

 .macro PVAL miss
 movhu ({state}),d3
 add -1,d3
 cmp {lim},d3
 bcc \miss
 btst 3,d3
 bne \miss
 mov d3,a2
 add {pool},a2
 mov (a2),d3
 cmp {bmagic},d3
 bne \miss
 .endm

mp_lbl1:
 mov (8,sp),a1                    /* replay operand: a1 = (8,sp) */
 mov d3,a0
 bra mp_lblw
mp_lbl2:
 mov a2,a1                        /* replay operand: a1 = a2 */
 mov d2,a0
mp_lblw:                          /* frame: (0) calls, (4) d1, (8) operand, (12) GetValue out, (16) j / field,
                                     (20) P, (24) preset, (28) id; (48) = the stock call's return word */
 movm [d2,d3,a2,a3],(sp)
 add -32,sp
 mov a1,(8,sp)
 mov d1,(4,sp)
 mov a0,a3
 mov (400,a3),d0                  /* picture mode (setting 111, stored by the view update) -> m */
 clr d2
 cmp 57,d0
 beq 1f
 inc d2
 cmp 58,d0
 beq 1f
 inc d2
 cmp 59,d0
 beq 1f
 inc d2
 cmp 65,d0
 bne l_out
1:
 PVAL l_out                       /* a2 = P */
 mov a2,(20,sp)
 clr d3                           /* d3 bit 0: Film page, bit 1: '*' */
 mov ({mmark},a2),d0
 cmp {mmagic},d0
 bne 2f
 movbu ({mpage},a2),d0
 cmp 1,d0
 bne 2f
 mov 1,d3
2:
 mov (672,a2),d0                  /* a2 = the preset named like slot m, or 0 */
 cmp {nmagic},d0
 bne 6f
 mov d2,d0
 asl 4,d0
 add a2,d0
 add 608,d0
 mov d0,a0                        /* slot name P+608+16m */
 mov mp_tab,a1
 clr d0
 mov d0,(16,sp)                   /* j */
3:
 clr d1                           /* 16-byte compare as 4 words (P+608+16m and the table are 4-aligned) */
4:
 mov (d1,a0),d0
 mov (d1,a1),a2
 cmp a2,d0
 bne 5f
 add 4,d1
 cmp 16,d1
 bne 4b
 mov a1,a2                        /* match */
 bra 7f
5:
 add 24,a1
 mov (16,sp),d0
 inc d0
 mov d0,(16,sp)
 cmp {n},d0
 bne 3b
6:
 mov 0,a2                         /* no preset */
 bra l_text
7:
 mov a2,(24,sp)                   /* '*': the {nf} settings of MONO m against the preset */
 clr d0
 mov d0,(16,sp)
8:
 mov (16,sp),d1
 mov d2,d0
 asl 3,d0
 add d1,d0
 add d0,d0
 mov mp_ids,a1
 add d0,a1
 movhu (a1),d0                    /* id of field f for MONO m */
 mov d0,(28,sp)
 call ep7_facade,[],4             /* a0 = OlyApiSettingControllerController */
 mov (a0),a2
 mov (8,a2),a2                    /* GetValue(id, &out) */
 mov sp,a1
 add 12,a1
 mov (28,sp),d0
 calls (a2)
 cmp 0,d0
 bne 9f                           /* no value: this field adds no '*' */
 mov (24,sp),a0
 add 16,a0
 mov (16,sp),d1
 movbu (d1,a0),d0                 /* preset value (low byte) */
 movbu (12,sp),d1                 /* current value (low byte) */
 cmp d1,d0
 beq 9f
 or 2,d3
9:
 mov (16,sp),d0
 inc d0
 mov d0,(16,sp)
 cmp {nf},d0
 bne 8b
 mov (24,sp),a2
l_text:                           /* a2 = preset or 0, d3 = flags */
 mov (404,a3),d1                  /* guide slot, as the stock pages pick it */
 mov 260,d0
 cmp 1,d1
 bne 1f
 mov 186,d0
1:
 add a3,d0
 mov d0,a0
 mov 5,d1
 movhu d1,(a0)                    /* kind 5: text inline at +8 */
 mov 2,d1
 movhu d1,(6,a0)                  /* style as the stock guide */
 add 8,a0
 mov a0,a1
 clr d0
 mov 33,d1
2:
 movhu d0,(a1)                    /* clear text[0..32] */
 add 2,a1
 add -1,d1
 bne 2b
 btst 1,d3
 beq 4f
 mov mp_t_film,a1                 /* Film page */
 call l_put,[],0
 cmp 0,a2
 bne 3f
 mov mp_t_cust,a1
 call l_put,[],0
 bra l_out
3:
 mov a2,a1
 call l_put,[],0
 btst 2,d3
 beq l_out
 mov mp_t_star,a1
 call l_put,[],0
 bra l_out
4:
 cmp 0,a2                         /* stock page */
 bne 5f
 mov mp_t_fm,a1
 call l_put,[],0
 bra l_out
5:
 mov a2,a1
 call l_put,[],0
 btst 2,d3
 beq 6f
 mov mp_t_star,a1
 call l_put,[],0
6:
 mov mp_t_menu,a1
 call l_put,[],0
l_out:
 mov (48,sp),d0                   /* mdr = the stock call's return (our calls changed it) */
 mov d0,mdr
 mov (8,sp),a0                    /* replay 0x60e26789: a0 = a1 = operand, d0 = (84,a1) */
 mov (4,sp),d1
 add 32,sp
 movm (sp),[d2,d3,a2,a3]
 mov a0,a1
 mov (84,a1),d0
 retf [],0

/* l_put: ASCIZ a1 -> 16-bit label units at a0 (a0 advances). Clobbers d0, a1. `call l_put,[],0`. */
l_put:
 movbu (a1),d0
 cmp 0,d0
 beq 1f
 movhu d0,(a0)
 inc a1
 add 2,a0
 bra l_put
1:
 retf [],0

mp_t_film:
 .asciz "Film: "
mp_t_cust:
 .asciz "Custom"
mp_t_star:
 .asciz "*"
mp_t_menu:
 .asciz "[INFO]"
mp_t_fm:
 .asciz "Film[INFO]"

 .balign 4
mp_data:
mp_keys:                          /* filter editors MONO1-4, then shading editors MONO1-4 */
 .hword 0x13b6,0x13b7,0x13b8,0x140d,0x13b9,0x13ba,0x13bb,0x140e
mp_ids:                           /* per MONO m: filter, strength, toning, grain, shading, highlights, shadows, midtones */
{ids}
mp_tab:                           /* 24-byte presets: name[16] (NUL-padded), then the {nf} setting values (s8) */
{tab}
mp_end:
