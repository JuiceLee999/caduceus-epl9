/* E-P7 1.1 mono film presets on the stock Mono Profile editors (ep7-firmware, our own code). docs/MONO_PRESETS.md.
 * Part A (code): section 1, dead EVF gamma step-6 B + step-5 R/G/B tables 0x601e283c.. (only refs: step-table
 * words 0x601e3ce8, 0x601e3cd0/d4/d8). Part B (mp_b: label, keys, ids, presets): dead EVF step-11 tables.
 *
 * v0.15 picker. Hooked words of the 8 MONO editor records (filter keys 0x13b6/0x13b7/0x13b8/0x140d, shading keys
 * 0x13b9/0x13ba/0x13bb/0x140e), all CALLS entries (d0 event, d1 arg, a0 parent):
 *   +4  init  -> mp_init : Film page off (P+{mpage} = 0) when a card table is loaded, then jmp stock init.
 *   +44 INFO  -> op 0    : toggle the Film page (12d camera: INFO reaches the editors; MENU/PLAYBACK do not).
 *   +12 Up / +20 Left -> op 1 / 3: on the Film page, next preset.  +16 Down / +24 Right -> op 2 / 4: previous
 *                          (the stock handlers send 0x9004 to the child for Up and Left). Every dial notch and
 *                          touch drag reaches these words through parent+48..+60.
 *   +28 filter rear dial -> mp_d1_f: on the Film page jmp the shading editor's dial routine 0x60e22df0 (same
 *                          delta, Up/Down helpers, no setting-130 gate), else the stock 0x60e22bf6.
 * Take-over needs: card table (valid P), parent != 0, key -> MONO m of the record's kind, 1..2 children, no held
 * gesture, and for the arrows the Film page (P+{mmark} 'EP7M' and P+{mpage} == 1). A preset step writes the {nf}
 * stock settings of MONO m through the facade SetValue (the stock edit path), the slot name P+608+16m ('EP7N';
 * names zeroed first when the table had none) and dirty (the editor's half-press save writes BUNDLES.BIN).
 * After a step or a page toggle: stock child refresh 0x60de3670 on every child, then the editor's own first
 * setting (filter / shading) is re-written with its current value (GetValue, SetValue) so the listeners rebuild
 * the screen and the guide label (mp_lbl). Return 1.
 * Everything else: jmp to the record's stock word with d0/d1/a0/a1/d2/d3/a2/a3, sp and mdr as at entry.
 * First take-over since the load: 'EP7E' block initialised as the colour editor does; positions from the saved
 * names; page 0; then 'EP7M' at P+{mmark}.
 * Stores: P (heap) and the stack only. No absolute stores, no mul/div, no setlb/Lcc.
 */
 .am33_2
 .text
 .global _start
_start:

 .macro PVAL miss
 movhu ({state}),d3
 add -1,d3
 cmp {lim},d3
 bcc \miss
 btst 3,d3
 bne \miss
 mov d3,a2
 add {pool},a2
 mov (a2),d3
 cmp {bmagic},d3
 bne \miss
 .endm

/* op = 2 act + kind (kind 0 filter, 1 shading); act 0 INFO, 1 Up, 2 Down, 3 Left, 4 Right. */
 .macro ENT op
 movm [d2,d3,a2,a3],(sp)
 mov \op,d2
 bra mp_go
 .endm
mp_info_f:
 ENT 0
mp_info_s:
 ENT 1
mp_up_f:
 ENT 2
mp_up_s:
 ENT 3
mp_dn_f:
 ENT 4
mp_dn_s:
 ENT 5
mp_lt_f:
 ENT 6
mp_lt_s:
 ENT 7
mp_rt_f:
 ENT 8
mp_rt_s:
 ENT 9

mp_go:                            /* frame: (0) calls, (4) d0, (8) d1, (12) a1, (16) op, (20) value, (24) r, (28) P */
 add -32,sp
 mov d2,(16,sp)
 mov d0,(4,sp)
 mov d1,(8,sp)
 mov a1,(12,sp)
 mov a0,a3
 cmp 0,a3
 beq m_miss
 mov d2,d3                        /* event gate by act */
 lsr 1,d3
 cmp 0,d3
 bne 1f
 cmp 0x9014,d0                    /* INFO word: INFO only */
 bne m_miss
1:
 movhu (100,a3),d0                /* editor key -> m (d2) */
 and 1,d2
 asl 3,d2                         /* kind 0: keys 0..3, kind 1: keys 4..7 */
 mov mp_keys,a1
 add d2,a1
 clr d2
3:
 movhu (a1),d1
 cmp d1,d0
 beq 4f
 add 2,a1
 inc d2
 cmp 4,d2
 bne 3b
 bra m_miss
4:
 movhu (120,a3),d0                /* 1..2 children (filter: filter + strength; shading: 1) */
 add -1,d0
 cmp 2,d0
 bcc m_miss
 mov (16,a3),d0                   /* no held-key / timer gesture in progress */
 cmp 0,d0
 bne m_miss
 mov (44,a3),d0
 cmp 0,d0
 bne m_miss
 PVAL m_miss                      /* a2 = P */
 mov a2,(28,sp)
 mov (16,sp),d0                   /* arrows: only on the Film page (checked before any heap write) */
 lsr 1,d0
 add -1,d0
 cmp 4,d0
 bcc 5f
 mov ({mmark},a2),d0
 cmp {mmagic},d0
 bne m_miss
 movbu ({mpage},a2),d0
 cmp 1,d0
 bne m_miss
5:                                /* take-over from here (no miss below) */
 mov ({emark},a2),d0              /* first use since the load: 'EP7E' block as the colour editor sets it */
 cmp {emagic},d0
 beq 6f
 clr d0
 movbu d0,({axis},a2)
 movbu d0,({dirty},a2)
 movbu d0,({status},a2)
 mov {emagic},d0
 mov d0,({emark},a2)
6:
 mov ({mmark},a2),d0
 cmp {mmagic},d0
 beq 7f
 call mp_resume,[d2,d3,a3],12     /* positions from the saved names, page 0, then 'EP7M' */
7:
 mov (16,sp),d0
 lsr 1,d0                         /* act */
 cmp 0,d0
 bne 8f
 movbu ({mpage},a2),d1            /* INFO: toggle the Film page */
 xor 1,d1
 and 1,d1
 movbu d1,({mpage},a2)
 bra m_redraw
8:
 mov 1,d1                         /* direction as the stock child step: Up / Left +1 (0x9004), Down / Right -1 */
 cmp 2,d0
 beq 81f
 cmp 4,d0
 bne 82f
81:
 mov -1,d1
82:
 mov a2,a0
 add d2,a0
 movbu ({mpos},a0),d0
 add d1,d0
 cmp 0,d0                         /* 0 / -1 -> n (previous of the first, or of none) */
 bgt 9f
 mov {n},d0
9:
 cmp {n},d0                       /* above n (wrap, or a stale position) -> 1 */
 bls 10f
 mov 1,d0
10:
 movbu d0,({mpos},a0)
 add -1,d0                        /* r = mp_tab + 24 (pos - 1) */
 asl 3,d0
 mov d0,d1
 add d0,d0
 add d1,d0
 add mp_tab,d0
 mov d0,(24,sp)
 clr d3                           /* fields 0..{nf}-1 */
11:
 call mp_set,[],0
 inc d3
 cmp {nf},d3
 bne 11b
 mov (672,a2),d0                  /* names section: zero it first when the table had none */
 cmp {nmagic},d0
 beq 13f
 mov a2,a0
 add 544,a0
 clr d0
 mov 128,d1
12:
 movbu d0,(a0)
 inc a0
 add -1,d1
 bne 12b
13:
 mov d2,d0                        /* name P + 608 + 16 m */
 asl 4,d0
 add a2,d0
 add 608,d0
 mov d0,a0
 mov (24,sp),a1
 clr d1
14:
 movbu (d1,a1),d0
 movbu d0,(d1,a0)
 inc d1
 cmp 16,d1
 bne 14b
 mov {nmagic},d0
 mov d0,(672,a2)
 mov 1,d0
 movbu d0,({dirty},a2)            /* the editor's save writes BUNDLES.BIN on the next half-press */
m_redraw:
 mov d2,(4,sp)                    /* m (the entry d0 slot: no miss after this point) */
 movhu (120,a3),d2                /* children: refresh from the settings (stock routine) */
 mov 124,d3
15:
 mov a3,a0
 add d3,a0
 mov (a0),a0
 cmp 0,a0
 beq 16f
 call ep7_refresh,[d2,d3,a2,a3],60
16:
 add 4,d3
 add -1,d2
 bne 15b
 mov (4,sp),d2                    /* poke: field 0 (filter) or 4 (shading) of MONO m, its current value again */
 mov (16,sp),d3
 and 1,d3
 asl2 d3
 call mp_poke,[],0
 mov 1,d0
 ret [d2,d3,a2,a3],48
m_miss:                           /* a3 = entry a0 here */
 mov (16,sp),d2                   /* a0 = mp_tramp + 8 op */
 asl 3,d2
 mov mp_tramp,a0
 add d2,a0
 mov (4,sp),d0
 mov (8,sp),d1
 mov (12,sp),a1
 add 32,sp
 jmp (a0)

/* 8-byte trampolines in op order: a0 back, d2/d3/a2/a3 back, jmp the stock word (build-checked spacing). */
 .macro TR tgt
 mov a3,a0
 movm (sp),[d2,d3,a2,a3]
 jmp \tgt
 .endm
 .balign 4
mp_tramp:
 TR ep7_info_f
 TR ep7_info_s
 TR ep7_up_f
 TR ep7_up_s
 TR ep7_dn_f
 TR ep7_dn_s
 TR ep7_lt_f
 TR ep7_lt_s
 TR ep7_rt_f
 TR ep7_rt_s
mp_tramp_end:

/* mp_d1_f <- filter records' +28 (stock 0x60e22bf6: steps strength via Up/Down only when setting 130 != 0).
 * Film page (valid P, 'EP7M', page 1, a0 != 0): jmp 0x60e22df0 (the shading editor's dial routine: delta from
 * 0x60ea3b35, then Up/Down helpers -> parent+48/+52 = mp_up_f / mp_dn_f with their full guards). Registers intact. */
mp_d1_f:
 movm [d3,a2],(sp)
 cmp 0,a0
 beq 1f
 PVAL 1f
 mov ({mmark},a2),d3
 cmp {mmagic},d3
 bne 1f
 movbu ({mpage},a2),d3
 cmp 1,d3
 bne 1f
 movm (sp),[d3,a2]
 jmp ep7_d1_s
1:
 movm (sp),[d3,a2]
 jmp ep7_d1_f

/* mp_init <- the 8 records' +4 (stock 0x60e20a54, CALLS: a0 parent, d0 key): Film page off, then stock. */
mp_init:
 movm [d3,a2],(sp)
 PVAL 1f
 clr d3
 movbu d3,({mpage},a2)
1:
 movm (sp),[d3,a2]
 jmp ep7_init

/* mp_set: d2 = m, d3 = field. `call mp_set,[],0` (no frame: the caller's frame below, r at (24,sp), P at (28,sp)).
 * SetValue(id of field d3 for MONO m, 0, preset value) through the facade (vtable +0, the stock edit path); the
 * value is staged at (20,sp), the return word kept at (8,sp) (the entry d1 slot, dead once committed). a2 = P
 * after. Keeps d2/d3/a3. */
mp_set:
 mov mdr,d0
 mov d0,(8,sp)
 mov (24,sp),a0
 add d3,a0
 movbu (16,a0),d0
 extb d0
 mov d0,(20,sp)                   /* value */
mp_put:                           /* SetValue(id(m, d3), 0, (20,sp)); return word at (8,sp) */
 call ep7_facade,[],4             /* a0 = OlyApiSettingControllerController */
 mov (a0),a2
 mov (a2),a2                      /* SetValue(id, 0, value): the stock edit path */
 call mp_id,[],0
 clr d1
 mov (20,sp),a1
 calls (a2)
 mov (28,sp),a2                   /* P */
 mov (8,sp),d0
 mov d0,mdr
 retf [],0

/* mp_poke: d2 = m, d3 = field: GetValue(id) -> (20,sp); on success SetValue(id, 0, the same value). */
mp_poke:
 mov mdr,d0
 mov d0,(8,sp)
 call ep7_facade,[],4
 mov (a0),a2
 mov (8,a2),a2                    /* GetValue(id, &out) */
 call mp_id,[],0
 mov sp,a1
 add 20,a1
 calls (a2)
 cmp 0,d0
 beq mp_put
 mov (28,sp),a2
 mov (8,sp),d0
 mov d0,mdr
 retf [],0

/* mp_id: d0 = id of field d3 for MONO d2. Uses a1 only besides d0. Keeps mdr? no: callers reload theirs. */
mp_id:
 mov d2,d0
 asl 3,d0
 add d3,d0
 add d0,d0
 mov mp_ids,a1
 add d0,a1
 movhu (a1),d0
 rets

/* mp_resume: a2 = P. For m 0..3: pos = j+1 when name P+608+16m equals preset j's 16-byte name, else 0 (no names
 * section: 0). Then the Film page off and P+{mmark} = 'EP7M'. `call mp_resume,[d2,d3,a3],12`; clobbers d0, d1, a0, a1. */
mp_resume:
 clr d2                           /* m */
1:
 clr d3                           /* pos */
 mov (672,a2),d0
 cmp {nmagic},d0
 bne 5f
 mov mp_tab,a1
2:
 inc d3
 mov d2,d0
 asl 4,d0
 add a2,d0
 add 608,d0
 mov d0,a0
 clr d1                           /* 16-byte compare as 4 words (P, 608 + 16 m and the table are 4-aligned) */
3:
 mov (d1,a0),d0
 mov (d1,a1),a3
 cmp a3,d0
 bne 4f
 add 4,d1
 cmp 16,d1
 bne 3b
 bra 5f                           /* match: pos = d3 */
4:
 add 24,a1
 cmp {n},d3
 bne 2b
 clr d3                           /* no preset of that name */
5:
 mov a2,a0
 add d2,a0
 movbu d3,({mpos},a0)
 inc d2
 cmp 4,d2
 bne 1b
 clr d0
 movbu d0,({mpage},a2)
 mov {mmagic},d0
 mov d0,({mmark},a2)
 ret [d2,d3,a3],12
mp_end_a:
