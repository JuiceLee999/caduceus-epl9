/* E-P7 1.1 v0.24: a Film pick sets the profile's saturation from the look (ep7-firmware, our own code).
 * In the dead EVF step-7 tables after look_tone. lt_tone's H/M/S loop tail (5-byte jmp + 2 nops) -> sp_tail, so the
 * slot and record checks are lt_tone's own (library look with the tone flag; not Own / Stock). At loop exit: a3 = record
 * +38, d2 = HL id + 3 (966/969/972 COLOR1-3, 1675 COLOR4). Marker +44 == 1: stock saturation settings of the slot
 * (927/939/951/1655 + sector, the ids the editor's Saturation page edits) = the 12 nibbles at +38..43 (low nibble first,
 * two's complement) through the facade SetValue(id, 0, value), as for H/M/S. On the Film page (axis 3) ed_set and
 * ex_set both miss, so the write reaches the stock setting. No marker: nothing. Then lt_tone's t_ret.
 * Stores: stack only. No absolute stores, no mul/div, no setlb/Lcc.
 */
 .am33_2
 .text
 .global _start
_start:

sp_tail:
 inc d2
 inc a3
 inc d3
 cmp 3,d3
 bcc 1f
 jmp ep7_lt_loop
1:
 movbu (6,a3),d0
 cmp 1,d0
 bne 9f
 cmp 1675,d2
 bne 2f
 mov 1655,d2
 bra 3f
2:
 add -966,d2                      /* 3 k */
 asl 2,d2                         /* 12 k */
 add 927,d2
3:
 clr d3                           /* d3 = sector */
4:
 call ep7_facade,[],4             /* a0 = OlyApiSettingControllerController (kept for the call) */
 mov (a0),a2
 mov (a2),a2
 mov d3,d0
 lsr 1,d0
 mov a3,a1
 add d0,a1
 movbu (a1),d1
 btst 1,d3
 beq 5f
 lsr 4,d1
5:
 and 15,d1
 cmp 8,d1
 bcs 6f
 add -16,d1
6:
 mov d1,a1
 clr d1
 mov d2,d0
 calls (a2)
 inc d2
 inc d3
 cmp 12,d3
 bcs 4b
9:
 jmp ep7_t_ret

 .balign 4
sp_end:
