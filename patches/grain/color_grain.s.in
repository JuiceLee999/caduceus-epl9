/* E-P7 1.1 "COLOR grain" patch (ep7-firmware, our own code).
 *
 * Gives Color Profile (picture mode / job key 11) images the stock single-pass
 * grain stage that the MONO route already uses for its reduced job classes:
 *   request stage 0x0902  ->  combiner 32  ->  handler 0x603a065b
 *   (gain = table 0x604ec0d4[level-1] = 50/75/100, seed = RAM counter 0xa27393f8).
 *
 * Three pieces, one contiguous blob in the section-2 FF tail:
 *   wl_hook   work-list builder 0x60357415, replaces 7 bytes at 0x6035749f
 *             (cmp 12,d2 / bcc / jmp default). Key 11 gets the stock default
 *             development entry PLUS our request modifier, exactly like the
 *             stock MONO (key 12, job+11320!=0) route at 0x603577b6..0x603578a7.
 *   sel_hook  combiner selector 0x603b5200, replaces 7 bytes at 0x603b5249.
 *             Key 11 + kind-0 request + stage 0x0902 -> return 32 (stock key-12
 *             rule at 0x603b531a). Everything else: stock paths, untouched.
 *   grain_mod request modifier (stock analogue 0x60359e5e): kind-0 request ->
 *             stage 0x0902; level byte request+1828 per MODE below.
 *
 * MODE fixed (approach B): request+1828 = {level} unconditionally.
 * MODE mono  (approach A): request+1828 is left as packed from params+5551;
 *             level 0 (Off) => modifier does nothing (stage stays 0, no grain).
 */
 .am33_2
 .text
 .global _start
_start:

/* ---- work-list hook: entered by jmp from 0x6035749f; d2 = job key (job+11308),
 *      a3 = work list, frame of 0x60357415 untouched. */
wl_hook:
 cmp 12,d2
 bcc wl_to_hash                   /* key >= 12 (unsigned): stock hash dispatch */
 cmp 11,d2
 bne wl_to_default                /* other picture modes: stock default */
 mov a3,a0
 mov 0x60356d7b,a1                /* stock default development entry ... */
 mov 0x60356cc6,d1                /* ... and its completion callback */
 mov 1,d0
 call ep7_wl_add_final,[d2,d3,a2,a3],16   /* = 0x603578b8 */
 mov a3,a0
 mov grain_mod,a1
 call ep7_wl_attach,[a2,a3],8     /* = 0x603578a2 (attach modifier to that entry) */
 jmp ep7_wl_after                 /* 0x603578bd: stock feature-bit chain */
wl_to_hash:
 jmp ep7_wl_hash                  /* 0x603574a6 */
wl_to_default:
 jmp ep7_wl_default               /* 0x603578a9 */

/* ---- selector hook: entered by jmp from 0x603b5249; d2 = key (context+52),
 *      a2 = context+4, frame = call ...,[d2,a2],12 */
sel_hook:
 cmp 12,d2
 bcc sel_to_hash
 cmp 11,d2
 bne sel_to_default
 mov (a2),a1                      /* request */
 movbu (16,a1),d0                 /* kind */
 cmp 0,d0
 bne sel_to_default
 movhu (12,a1),d0                 /* stage */
 cmp 2306,d0                      /* 0x0902 */
 bne sel_to_default
 mov 32,d0                        /* combiner 32 (single-pass grain) */
 ret [d2,a2],12
sel_to_hash:
 jmp ep7_sel_hash                 /* 0x603b5250 */
sel_to_default:
 jmp ep7_sel_default              /* 0x603b539f */

/* ---- request modifier: called via 'calls (a2)' from 0x60356d72 with
 *      a0 = job, a1 = request; leaf, returns with retf like 0x60359e5e. */
grain_mod:
 movbu (16,a1),d0
 cmp 0,d0
 bne mod_done                     /* only kind-0 (development) requests */
{level_code}
 mov 2306,d0
 movhu d0,(12,a1)                 /* stage 0x0902 */
mod_done:
 clr d0
 retf [],0
